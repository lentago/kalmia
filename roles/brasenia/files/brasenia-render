#!/usr/bin/env python3
"""brasenia-render: the one renderer behind the office Roku's stream and its
peek (kalmia#194). It replaced lunaria-frames' rendering, lunaria-shooter and
lunaria-peek.

It keeps one headless Chromium running, driven over the DevTools protocol on
a pipe (--remote-debugging-pipe, stdlib only), and a ready 4K image of every
item the compositor's line-up lists (lentago/brasenia Contracts v1). A switch
to a rendered item is then a file swap, and the remote's peek shows the same
image as the screen. Rendering runs on a worker thread, so a slow or stuck
render never holds up the pointer, a switch, or the band rotation.

What is on screen: the pane the pointer (current.json) names, or its sibling
rendition (BRASENIA_PREFER_RENDITION, e.g. detail.html) when it offers one; the
briefing slot when the pointer falls back to it (or there is no compositor);
the status card; or, with BRASENIA_PIN_URL, that one page. Its bands (16:9
screenfuls) go to frame.png in turn, each for BRASENIA_BAND_DWELL seconds, and
brasenia-stream encodes frame.png.

When it renders: the item on screen first, then the household's default
resting pane, then the rest of the line-up, one at a time. An item renders
when it is new or its content revision (rev) changes; a link pane also every
source.refresh_s; an item without a rev every BRASENIA_REGEN_INTERVAL while on
screen and BRASENIA_PEEK_REGEN otherwise. A failed render keeps the previous
image and is retried after RETRY_S: a stale page beats a dead screen.

Which sites (docs/brasenia.md has the reasoning, threat model and limits): a
pane without a link source renders only from pub.lan. Documents must be
pub.lan or, while Chromium runs sandboxed (it needs user namespaces, which
LXC 118 has with nesting), a host in BRASENIA_ALLOWED_SITES or a subdomain of
one. Every document request is checked (Fetch), every redirect hop included,
and the final URL again before the capture. A link pane renders in its own
disposable browser context, where no document but pub.lan, and no
subresource, may reach a private address (names resolved per render), popups
are disabled, and every child frame or worker is held until the same
interception is on it. If the sandboxed browser cannot start, an unsandboxed
one renders pub.lan pages only, and the sandbox is tried again every
SANDBOX_RETRY_S. A refused page is shown as a notice naming the site, and is
tried again once the sandbox is back.

Pane-contract pages are laid out at 1280x720 CSS pixels and rendered at
BRASENIA_SCALE, one band per 720 px with content (up to 4). A page that declares
<meta name="brasenia-canvas" content="1920x1080"> (lentago/brasenia ADR-0019)
is laid out at 1920x1080 per band instead, at the scale that keeps a band the
same size in device pixels: 2x at BRASENIA_SCALE 3. Link panes
(lentago/brasenia ADR-0016) are laid out at source.viewport with
prefers-color-scheme set to source.theme, and their first source.screens bands
are each fitted onto a full-size band. Their settings are clamped to the contract's
ranges here too, so a bad line-up can never make the renderer spin.

`brasenia-render --once URL [URL ...] [--source JSON] --out DIR` renders the
URLs in one browser to DIR/NN-band-MM.png and exits, for testing.
"""
import argparse, base64, fcntl, io, ipaddress, json, math, os, queue, select, shutil, signal
import socket, subprocess, sys, tempfile, threading, time, urllib.error, urllib.request
from datetime import datetime, timezone
from urllib.parse import urlsplit
from PIL import Image, ImageChops, ImageDraw, ImageFont

E = os.environ.get
HOME = E("BRASENIA_HOME", "/var/lib/brasenia")
CACHE = os.path.join(HOME, "render")
FRAME = os.path.join(HOME, "frame.png")
PEEK_DIR = E("BRASENIA_PEEK_DIR", "/run/brasenia-peek")
POINTER_URL = E("BRASENIA_POINTER_URL", "http://pub.lan/viewport/current.json")
LINEUP_URL = E("BRASENIA_LINEUP_URL", "http://pub.lan/viewport/lineup.json")
BRIEFING_URL = E("BRASENIA_BRIEFING_URL", "http://pub.lan/viewport/briefing/pane.html")
PIN_URL = E("BRASENIA_PIN_URL", "")
PREFER = E("BRASENIA_PREFER_RENDITION", "")
ALLOWED_SITES = [h.lower() for h in E("BRASENIA_ALLOWED_SITES", "").split()]
PUB_HOST = "pub.lan"


def seconds(name, default):
    value = E(name, str(default))
    if not value.isdigit() or int(value) < 1:
        sys.exit(f"brasenia-render: {name} must be a positive whole number of seconds, got {value!r}")
    return int(value)


POLL = seconds("BRASENIA_POINTER_POLL", 1)
LINEUP_POLL = seconds("BRASENIA_PEEK_POLL", 10)
DWELL = seconds("BRASENIA_BAND_DWELL", 12)
REGEN = seconds("BRASENIA_REGEN_INTERVAL", 60)
PEEK_REGEN = seconds("BRASENIA_PEEK_REGEN", 300)
SCALE = E("BRASENIA_SCALE", "1")
if SCALE not in ("1", "2", "3", "4"):
    sys.exit(f"brasenia-render: BRASENIA_SCALE must be 1-4, got {SCALE!r}")
SCALE = int(SCALE)
CSS_W, CSS_H = 1280, 720                       # the pane contract
OUT_W, OUT_H = CSS_W * SCALE, CSS_H * SCALE    # one band, device pixels
# A page that declares this canvas is laid out at it per band (lentago/brasenia
# ADR-0019), scaled so a band is still OUT_W x OUT_H.
CANVAS_META = "1920x1080"
CANVAS_W, CANVAS_H = 1920, 1080
PEEK_SIZE = (1920, 1080)                       # the Roku UI plane's limit
BG = (14, 22, 18)                              # the panes' background, around a fitted link page
BG_TOLERANCE = 12                              # px difference below this counts as background
FONT = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"
# Link pane settings (lentago/brasenia ADR-0016), clamped to the contract here.
THEMES = ("dark", "light")
VIEWPORT_RANGE = (240, 3840)
REFRESH_RANGE = (10, 86400)
SOURCE_DEFAULTS = {"theme": "dark", "screens": 1, "viewport": [1280, 720], "refresh_s": 60}
RETRY_S = 30            # before rendering a failed item again
BACKGROUND_GAP_S = 2    # between off-screen renders, so the encoder keeps its CPU
STALE_S = 30            # an unreadable pointer is logged after this long
SANDBOX_RETRY_S = 600   # an unsandboxed fallback tries the sandbox again after this
BROWSER_MAX_AGE_S = 6 * 3600
CALL_TIMEOUT_S, CAPTURE_TIMEOUT_S = 15, 30
PUB_LOAD_TIMEOUT_S, LINK_LOAD_TIMEOUT_S = 15, 25


def log(msg):
    print(msg, file=sys.stderr, flush=True)


class RenderError(Exception):
    pass


class Refused(RenderError):
    """A site this renderer will not show."""


# ---------------------------------------------------------------- sites ----

def sandbox_available():
    """True when this user can create a user namespace, as Chromium's sandbox needs."""
    try:
        return subprocess.run(["unshare", "--user", "--map-root-user", "true"],
                              capture_output=True, timeout=10).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def host_of(url):
    try:
        return (urlsplit(url).hostname or "").lower()
    except ValueError:
        return ""


def site_allowed(url, sandboxed):
    host = host_of(url)
    if host == PUB_HOST:
        return True
    return sandboxed and any(host == s or host.endswith("." + s) for s in ALLOWED_SITES)


def check_site(url, sandboxed):
    if site_allowed(url, sandboxed):
        return
    host = host_of(url) or url
    if not sandboxed:
        raise Refused(f"{host}: Chromium is not sandboxed, so only {PUB_HOST} pages render")
    raise Refused(f"{host} is not in brasenia_allowed_sites (kalmia roles/brasenia)")


def http_status(url, timeout=5):
    req = urllib.request.Request(url, method="HEAD", headers={"Cache-Control": "no-cache"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.status
    except urllib.error.HTTPError as exc:
        return exc.code
    except Exception:
        return None


def rendition(url):
    """A pub.lan pane's preferred sibling rendition, when it offers one."""
    if PREFER and host_of(url) == PUB_HOST and url.endswith("/pane.html"):
        alt = url[:-len("pane.html")] + PREFER
        if http_status(alt) == 200:
            return alt
    return url


# -------------------------------------------------------------- browser ----

# Requests a page in a link render may never make: anything on the LAN or the
# host itself. Checked by name, as an address, and after resolving the name.
PRIVATE_SUFFIXES = (".lan", ".local", ".internal", ".home.arpa", ".localhost")


def private_ip(ip):
    """Not on the public internet: RFC1918, CGNAT/Tailscale (100.64/10),
    loopback, link-local, IPv6 ULA and site-local, and the like."""
    if ip.version == 6 and ip.ipv4_mapped:
        ip = ip.ipv4_mapped
    return not ip.is_global or ip.is_multicast or getattr(ip, "is_site_local", False)


class Browser:
    """One headless Chromium, driven over --remote-debugging-pipe: requests on
    fd 3 and replies on fd 4, each a JSON message ending in a NUL byte.

    Two kinds of page session:
    - the persistent one, for pub.lan pages: every document request (each
      redirect hop, frames, self-navigation) is paused (Fetch) and continued
      only when its host is allowed for this browser's sandbox mode;
    - a link render's, in its own disposable browser context: every request
      is paused; documents must be allowed sites, and nothing may reach a
      private address. Popups are disabled, and every child target (an
      out-of-process frame, a worker) is attached before it runs and stays
      paused unless the same interception is enabled on it.
    The context, with its service workers and storage, is disposed after the
    render."""

    DOCUMENTS = [{"urlPattern": "*", "resourceType": "Document", "requestStage": "Request"}]
    EVERYTHING = [{"urlPattern": "*", "requestStage": "Request"}]
    NO_POPUPS = "window.open = function () { return null; };"

    def __init__(self, sandboxed):
        self.sandboxed = sandboxed
        self.proc = None
        self.wfd = self.rfd = None
        self.profile = None

    def start(self):
        self.profile = tempfile.mkdtemp(prefix="brasenia-render-")
        r_in = w_in = r_out = w_out = hi_in = hi_out = None
        try:
            r_in, w_in = os.pipe()
            r_out, w_out = os.pipe()
            # Chromium's ends go to fds 3 and 4 through bash, not a preexec_fn,
            # which is unsafe in a process with threads. They are copied above
            # fd 9 first, so placing them can never close one onto the other.
            hi_in = fcntl.fcntl(r_in, fcntl.F_DUPFD_CLOEXEC, 10)
            hi_out = fcntl.fcntl(w_out, fcntl.F_DUPFD_CLOEXEC, 10)
            args = ["chromium", "--headless=new", *([] if self.sandboxed else ["--no-sandbox"]),
                    "--disable-gpu", "--no-first-run", "--no-default-browser-check",
                    "--hide-scrollbars", "--mute-audio", "--remote-debugging-pipe",
                    # Fetch never sees these, so they are off: WebRTC's UDP
                    # and DNS prefetching.
                    "--force-webrtc-ip-handling-policy=disable_non_proxied_udp",
                    "--dns-prefetch-disable",
                    "--user-data-dir=" + self.profile, "about:blank"]
            self.proc = subprocess.Popen(
                ["/bin/bash", "-c", f'exec "$@" 3<&{hi_in} 4>&{hi_out} {hi_in}<&- {hi_out}>&-',
                 "bash", *args],
                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                pass_fds=(hi_in, hi_out))
        except Exception:
            for fd in (r_in, w_in, r_out, w_out, hi_in, hi_out):
                if fd is not None:
                    os.close(fd)
            shutil.rmtree(self.profile, ignore_errors=True)
            self.proc = None
            raise
        for fd in (r_in, w_out, hi_in, hi_out):
            os.close(fd)
        self.wfd, self.rfd = w_in, r_out
        self.buf, self.mid, self.born = b"", 0, time.monotonic()
        self.lifecycle, self.blocked = set(), []
        self.pending = {}        # reply id -> callback(reply)
        self.link_sessions = set()
        self.resolved = {}       # host -> private?
        self.session = None
        target = self.call("Target.createTarget", {"url": "about:blank"}, session=False)["targetId"]
        self.session = self.call("Target.attachToTarget", {"targetId": target, "flatten": True},
                                 session=False)["sessionId"]
        self.setup(self.session, link=False)

    def setup(self, session, link):
        """Prepare a page session; for a link render, before anything loads."""
        if link:
            self.link_sessions.add(session)
            self.call("Page.addScriptToEvaluateOnNewDocument", {"source": self.NO_POPUPS}, session=session)
        self.call("Page.enable", session=session)
        self.call("Page.setLifecycleEventsEnabled", {"enabled": True}, session=session)
        self.call("Network.enable", session=session)
        self.call("Network.setCacheDisabled", {"cacheDisabled": True}, session=session)   # never a stale page
        self.call("Fetch.enable", {"patterns": self.EVERYTHING if link else self.DOCUMENTS}, session=session)
        self.call("Target.setAutoAttach", {"autoAttach": True, "waitForDebuggerOnStart": True,
                                           "flatten": True}, session=session)

    def stop(self):
        try:
            if self.proc is not None:
                self.proc.terminate()
                try:
                    self.proc.wait(5)
                except subprocess.TimeoutExpired:
                    self.proc.kill()
                    self.proc.wait(5)
        except Exception as exc:     # never let a stuck child take the worker down
            log(f"chromium did not stop cleanly: {exc}")
        self.proc = None
        for fd in (self.wfd, self.rfd):
            if fd is not None:
                try:
                    os.close(fd)
                except OSError:
                    pass
        self.wfd = self.rfd = None
        if self.profile:
            shutil.rmtree(self.profile, ignore_errors=True)
            self.profile = None

    @property
    def alive(self):
        return self.proc is not None and self.proc.poll() is None

    @property
    def old(self):
        return time.monotonic() - self.born > BROWSER_MAX_AGE_S

    # --- the pipe ---------------------------------------------------------
    def _send(self, method, params=None, session=True, then=None):
        """Send a command; ``session`` True is the current page session,
        False the browser, a string that session. ``then`` is called with
        the reply when it arrives."""
        self.mid += 1
        msg = {"id": self.mid, "method": method, "params": params or {}}
        sid = self.session if session is True else (session or None)
        if sid:
            msg["sessionId"] = sid
        data = json.dumps(msg).encode() + b"\0"
        try:
            while data:
                data = data[os.write(self.wfd, data):]
        except OSError as exc:
            raise RenderError(f"chromium is gone ({exc})")
        if then:
            self.pending[self.mid] = then
        return self.mid

    def _read(self, deadline, what):
        """The next message, reading from the pipe until ``deadline``."""
        while b"\0" not in self.buf:
            left = deadline - time.monotonic()
            if left <= 0:
                raise RenderError(f"{what} timed out")
            if select.select([self.rfd], [], [], left)[0]:
                chunk = os.read(self.rfd, 1 << 20)
                if not chunk:
                    raise RenderError("chromium closed the pipe")
                self.buf += chunk
        raw, self.buf = self.buf.split(b"\0", 1)
        return json.loads(raw)

    def _handle(self, msg):
        """Anything read that is not the reply being waited for."""
        if "method" in msg:
            self._event(msg)
        elif msg.get("id") in self.pending:
            self.pending.pop(msg["id"])(msg)

    def private_host(self, host):
        host = host.strip("[]").lower()
        if not host or host == "localhost" or host.endswith(PRIVATE_SUFFIXES):
            return True
        try:
            return private_ip(ipaddress.ip_address(host))
        except ValueError:
            pass
        if host not in self.resolved:
            try:
                addrs = {ai[4][0].split("%")[0] for ai in socket.getaddrinfo(host, None)}
                self.resolved[host] = any(private_ip(ipaddress.ip_address(a)) for a in addrs)
            except (OSError, ValueError, UnicodeError):
                self.resolved[host] = True   # unresolvable: nothing is lost by blocking it
        return self.resolved[host]

    def _allowed(self, session, request_type, url):
        if session not in self.link_sessions:
            return site_allowed(url, self.sandboxed)          # documents only, pub.lan pages
        if request_type == "Document":
            host = host_of(url)
            return site_allowed(url, self.sandboxed) and (host == PUB_HOST or not self.private_host(host))
        scheme = urlsplit(url).scheme if url else ""
        if scheme in ("data", "blob"):
            return True
        return scheme in ("http", "https") and not self.private_host(host_of(url))

    def _event(self, msg):
        method, params, session = msg.get("method"), msg.get("params") or {}, msg.get("sessionId")
        if method == "Fetch.requestPaused":
            url = (params.get("request") or {}).get("url", "")
            if self._allowed(session, params.get("resourceType"), url):
                self._send("Fetch.continueRequest", {"requestId": params.get("requestId")}, session=session)
            else:
                self.blocked.append(url)
                self._send("Fetch.failRequest", {"requestId": params.get("requestId"),
                                                 "errorReason": "BlockedByClient"}, session=session)
        elif method == "Page.lifecycleEvent" and session == self.session:
            self.lifecycle.add((params.get("loaderId"), params.get("name")))
        elif method == "Target.attachedToTarget":
            self._child(session, params)

    def _child(self, parent, params):
        """A frame or worker attached before it runs: give it the parent's
        interception, and let it run only once that is confirmed."""
        child = params.get("sessionId")
        kind = (params.get("targetInfo") or {}).get("type")
        if not child:
            return
        link = parent in self.link_sessions
        if link:
            self.link_sessions.add(child)
            if kind in ("iframe", "page"):
                self._send("Page.addScriptToEvaluateOnNewDocument", {"source": self.NO_POPUPS}, session=child)
        self._send("Target.setAutoAttach", {"autoAttach": True, "waitForDebuggerOnStart": True,
                                            "flatten": True}, session=child)

        def enabled(reply):
            if "error" in reply:     # cannot intercept it: it never runs
                log(f"left a {kind} paused: no request interception ({reply['error'].get('message')})")
                return
            self._send("Runtime.runIfWaitingForDebugger", session=child)

        self._send("Fetch.enable", {"patterns": self.EVERYTHING if link else self.DOCUMENTS},
                   session=child, then=enabled)

    def call(self, method, params=None, session=True, timeout=CALL_TIMEOUT_S):
        mid = self._send(method, params, session)
        deadline = time.monotonic() + timeout
        while True:
            msg = self._read(deadline, method)
            if msg.get("id") == mid:
                if "error" in msg:
                    raise RenderError(f"{method}: {msg['error'].get('message')}")
                return msg.get("result", {})
            self._handle(msg)

    def wait_for(self, done, timeout, what):
        deadline = time.monotonic() + timeout
        while not done():
            self._handle(self._read(deadline, what))

    def evaluate(self, expression, await_promise=False, timeout=CALL_TIMEOUT_S):
        result = self.call("Runtime.evaluate", {"expression": expression, "returnByValue": True,
                                                "awaitPromise": await_promise}, timeout=timeout)
        return result.get("result", {}).get("value")

    # --- rendering --------------------------------------------------------
    def go(self, url, timeout):
        """Navigate and wait for that navigation's own load event, so a
        capture can never be of the previous document."""
        self.lifecycle = set()
        nav = self.call("Page.navigate", {"url": url}, timeout=timeout)
        if nav.get("errorText"):
            if self.blocked:
                raise Refused(f"{host_of(self.blocked[-1]) or self.blocked[-1]} is not allowed "
                              f"(reached from {url})")
            raise RenderError(f"{url}: {nav['errorText']}")
        loader = nav.get("loaderId")
        if loader:
            self.wait_for(lambda: (loader, "load") in self.lifecycle, timeout, f"loading {url}")
        else:   # a same-document navigation; about:blank first makes this rare
            deadline = time.monotonic() + timeout
            while self.evaluate("document.readyState") != "complete":
                if time.monotonic() > deadline:
                    raise RenderError(f"{url}: did not finish loading in {timeout}s")
                time.sleep(0.05)

    def load(self, url, css_w, css_h, scale, theme, settle, timeout):
        self.blocked = []
        self.call("Emulation.setDeviceMetricsOverride",
                  {"width": css_w, "height": css_h, "deviceScaleFactor": scale, "mobile": False})
        self.call("Emulation.setEmulatedMedia",
                  {"features": [{"name": "prefers-color-scheme", "value": theme}]})
        self.go("about:blank", timeout)
        self.go(url, timeout)
        self.evaluate("document.fonts ? document.fonts.ready.then(() => true) : true",
                      await_promise=True, timeout=timeout)
        status = self.evaluate("(performance.getEntriesByType('navigation')[0] || {}).responseStatus || 0")
        if isinstance(status, int) and status >= 400:
            raise RenderError(f"{url}: HTTP {status}")
        # Pause for late content, answering paused requests meanwhile.
        deadline = time.monotonic() + settle
        try:
            self.wait_for(lambda: False, settle, "settling")
        except RenderError as exc:
            if "timed out" not in str(exc) or time.monotonic() < deadline:
                raise
        # The page may have moved on by itself (a refresh, a script); whatever
        # is showing now must be allowed too.
        final = self.evaluate("location.href")
        check_site(final if isinstance(final, str) else "", self.sandboxed)

    def capture(self):
        data = self.call("Page.captureScreenshot", {"format": "png"}, timeout=CAPTURE_TIMEOUT_S)["data"]
        return Image.open(io.BytesIO(base64.b64decode(data))).convert("RGB")

    def contract_pages(self, url):
        """A pane-contract page, one band per 16:9 screenful of it (1-4): 1280x720
        CSS pixels a band, or 1920x1080 when it declares that canvas."""
        self.load(url, CSS_W, CSS_H, SCALE, "dark", 0.15, PUB_LOAD_TIMEOUT_S)
        width, band_h, scale = CSS_W, CSS_H, SCALE
        canvas = self.evaluate("(document.querySelector('meta[name=\"brasenia-canvas\"]') || {}).content || ''")
        if isinstance(canvas, str) and canvas.strip().lower() == CANVAS_META:
            width, band_h, scale = CANVAS_W, CANVAS_H, OUT_W / CANVAS_W
            self.call("Emulation.setDeviceMetricsOverride", {"width": width, "height": band_h,
                                                             "deviceScaleFactor": scale, "mobile": False})
            time.sleep(0.15)
        height = self.evaluate("Math.max(document.documentElement.scrollHeight,"
                               " document.body ? document.body.scrollHeight : 0)")
        height = height if isinstance(height, (int, float)) and math.isfinite(height) else band_h
        bands = max(1, min(4, -(-int(height) // band_h)))
        if bands > 1:
            self.call("Emulation.setDeviceMetricsOverride", {"width": width, "height": band_h * bands,
                                                             "deviceScaleFactor": scale, "mobile": False})
            time.sleep(0.15)
        shot = self.capture()
        # A page can be taller than its content (a desk edition zoomed to fit):
        # keep only the bands down to the last that has anything on it.
        bands = min(bands, max(1, -(-content_bottom(shot) // OUT_H)))
        return [shot.crop((0, i * OUT_H, OUT_W, (i + 1) * OUT_H)) for i in range(bands)]

    def link_pages(self, url, source):
        """A link pane, in its own disposable browser context: laid out at
        source.viewport, its first source.screens bands each fitted onto a page."""
        self.resolved = {}       # a name's answer is trusted for this render only
        context = self.call("Target.createBrowserContext", {"disposeOnDetach": True},
                            session=False)["browserContextId"]
        persistent = self.session
        try:
            target = self.call("Target.createTarget", {"url": "about:blank", "browserContextId": context},
                               session=False)["targetId"]
            self.session = self.call("Target.attachToTarget", {"targetId": target, "flatten": True},
                                     session=False)["sessionId"]
            self.setup(self.session, link=True)
            width, height = source["viewport"]
            screens = source["screens"]
            dpr = min(OUT_W / width, OUT_H / height)
            self.load(url, width, height * screens, dpr, source["theme"], 1.5, LINK_LOAD_TIMEOUT_S)
            shot = self.capture()
        finally:
            self.session = persistent
            self.link_sessions.clear()
            try:
                self.call("Target.disposeBrowserContext", {"browserContextId": context}, session=False)
            except RenderError as exc:
                log(f"could not dispose a link render's context: {exc}")
        band_w, band_h = round(width * dpr), round(height * dpr)
        pages = []
        for i in range(screens):
            band = shot.crop((0, i * band_h, min(shot.width, band_w), min(shot.height, (i + 1) * band_h)))
            page = Image.new("RGB", (OUT_W, OUT_H), BG)
            page.paste(band, ((OUT_W - band.width) // 2, (OUT_H - band.height) // 2))
            pages.append(page)
        return pages


def content_bottom(image):
    """The lowest row that differs from the background (the top-left pixel)
    by more than BG_TOLERANCE, so antialiasing and off-white noise don't count."""
    bg = image.getpixel((5, 5))
    diff = ImageChops.difference(image, Image.new("RGB", image.size, bg)).convert("L")
    box = diff.point(lambda p: 255 if p > BG_TOLERANCE else 0).getbbox()
    return box[3] if box else OUT_H


def notice_page(title, detail):
    """A plain dark page saying why an item cannot be shown, so the screen
    matches the compositor's decision instead of keeping an older pane."""
    page = Image.new("RGB", (OUT_W, OUT_H), BG)
    draw = ImageDraw.Draw(page)
    try:
        big, small = ImageFont.truetype(FONT, 44 * SCALE), ImageFont.truetype(FONT, 26 * SCALE)
    except OSError:
        big = small = ImageFont.load_default()
    draw.text((60 * SCALE, 250 * SCALE), title[:80], fill=(224, 168, 28), font=big)
    draw.text((60 * SCALE, 330 * SCALE), detail[:120], fill=(216, 228, 220), font=small)
    return page


# ---------------------------------------------------------------- items ----

def clean_source(source):
    """A link pane's display settings, clamped to the contract; None when there
    is no usable source at all."""
    if not isinstance(source, dict):
        return None
    out = dict(SOURCE_DEFAULTS)
    if source.get("theme") in THEMES:
        out["theme"] = source["theme"]
    screens = source.get("screens")
    if isinstance(screens, int) and not isinstance(screens, bool):
        out["screens"] = max(1, min(4, screens))
    vp = source.get("viewport")
    if (isinstance(vp, list) and len(vp) == 2
            and all(isinstance(v, int) and not isinstance(v, bool) for v in vp)):
        out["viewport"] = [max(VIEWPORT_RANGE[0], min(VIEWPORT_RANGE[1], v)) for v in vp]
    refresh = source.get("refresh_s")
    if isinstance(refresh, (int, float)) and not isinstance(refresh, bool) and math.isfinite(refresh):
        out["refresh_s"] = max(REFRESH_RANGE[0], min(REFRESH_RANGE[1], refresh))
    return out


def safe_id(text):
    return isinstance(text, str) and 0 < len(text) <= 64 and all(
        (c.isascii() and (c.isdigit() or c.islower())) or c in "-_" for c in text)


def web_url(text):
    return isinstance(text, str) and len(text) <= 2048 and text.startswith(("http://", "https://"))


class Item:
    """Something to render: a line-up item, or what the pointer names."""

    def __init__(self, item_id, url, rev=None, source=None, title=None, cls=None, showing=False):
        self.id, self.url, self.source = item_id, url, source
        self.rev = rev if isinstance(rev, str) else None
        self.title = title if isinstance(title, str) and title.strip() else item_id
        self.cls = cls if isinstance(cls, str) else None
        self.showing = showing is True

    @property
    def key(self):
        """What the rendered images depend on."""
        return json.dumps([self.url, self.rev, self.source], sort_keys=True)


def fetch_json(url):
    """``(doc, None)``, ``(None, "404")`` or ``(None, reason)``."""
    req = urllib.request.Request(url, headers={"Cache-Control": "no-cache"})
    try:
        with urllib.request.urlopen(req, timeout=2) as resp:
            return json.loads(resp.read()), None
    except urllib.error.HTTPError as exc:
        return None, "404" if exc.code == 404 else f"HTTP {exc.code}"
    except Exception as exc:
        return None, f"fetch failed: {exc}"


def item_from(entry):
    if not isinstance(entry, dict) or not safe_id(entry.get("id")) or not web_url(entry.get("url")):
        return None
    return Item(entry["id"], entry["url"], entry.get("rev"), clean_source(entry.get("source")),
                entry.get("title"), entry.get("class"), entry.get("showing"))


def target_from(pointer, why):
    """What the pointer puts on screen; None when it can't be read."""
    if why == "404":
        return Item("_briefing", BRIEFING_URL, title="Briefing")   # no compositor yet
    if why or not isinstance(pointer, dict) or pointer.get("schema") != 1:
        return None
    fallback = pointer.get("fallback")
    if fallback == "briefing":
        return Item("_briefing", BRIEFING_URL, pointer.get("rev"), title=pointer.get("title"))
    if fallback == "status" and web_url(pointer.get("url")):
        return Item("_status", pointer["url"], title=pointer.get("title"))
    if fallback is None and safe_id(pointer.get("pane")) and web_url(pointer.get("url")):
        return Item(pointer["pane"], pointer["url"], pointer.get("rev"),
                    clean_source(pointer.get("source")), pointer.get("title"))
    return None


# --------------------------------------------------------------- worker ----

class Worker(threading.Thread):
    """Owns the browser. Takes one item at a time, renders it, and writes its
    pages and peek image to a fresh directory under CACHE; the main thread
    installs the result. Nothing here touches what is on screen."""

    def __init__(self):
        super().__init__(daemon=True)
        self.capable = None      # can this user create namespaces? probed on first use
        self.browser = None
        self.fell_back = None    # monotonic time of an unsandboxed fallback
        self.jobs = queue.Queue(maxsize=1)
        self.results = queue.Queue()

    def mode(self):
        return "sandboxed" if self.browser and self.browser.sandboxed else (
            "unsandboxed (pub.lan only)" if self.browser else "not started")

    @property
    def sandboxed(self):
        return bool(self.browser and self.browser.sandboxed)

    def ensure_browser(self):
        if self.capable is None:
            self.capable = sandbox_available()
        retry = (self.fell_back is not None and time.monotonic() - self.fell_back > SANDBOX_RETRY_S)
        if self.browser and self.browser.alive and not self.browser.old and not retry:
            return
        self.drop_browser()
        for sandboxed in ([True, False] if self.capable else [False]):
            browser = Browser(sandboxed)
            try:
                browser.start()
            except Exception as exc:
                browser.stop()
                log(f"chromium {'sandboxed' if sandboxed else 'unsandboxed'} failed to start: {exc}")
                continue
            if self.capable and not sandboxed:
                log("chromium runs without its sandbox: only pub.lan pages render until it is tried again")
                self.fell_back = time.monotonic()
            else:
                self.fell_back = None
            self.browser = browser
            return
        raise RenderError("chromium would not start")

    def drop_browser(self):
        if self.browser:
            self.browser.stop()
            self.browser = None

    def render(self, item):
        self.ensure_browser()                        # first: it may fall back to unsandboxed
        if not item.source and host_of(item.url) != PUB_HOST:
            # Its session gates documents only, which is right for our own pages.
            raise Refused(f"{host_of(item.url) or item.url}: a pane without a source must be on {PUB_HOST}")
        check_site(item.url, self.browser.sandboxed)
        if item.source:
            return self.browser.link_pages(item.url, item.source)
        return self.browser.contract_pages(rendition(item.url))

    def run(self):
        while True:
            item = self.jobs.get()
            if item is None:
                self.drop_browser()
                return
            started = time.monotonic()
            try:
                self.results.put((item,) + self.job(item) + (time.monotonic() - started, self.sandboxed))
            except BaseException as exc:    # the thread must outlive any one item
                self.results.put((item, None, f"FAILED: {exc!r}", time.monotonic() - started, self.sandboxed))
                try:
                    self.drop_browser()
                except BaseException:
                    self.browser = None

    def job(self, item):
        """Render one item and save it; ``(result, outcome)``."""
        try:
            pages, outcome = self.render(item), "ok"
        except Refused as exc:
            pages, outcome = [notice_page(f"{item.title}: this page isn't shown here", str(exc))], f"refused: {exc}"
        except Exception as exc:
            if not isinstance(exc, RenderError) or "timed out" in str(exc) or "chromium" in str(exc):
                self.drop_browser()      # a fresh one next time
            return None, f"FAILED: {exc}"
        work = tempfile.mkdtemp(prefix="." + item.id + "-", dir=CACHE)
        for i, page in enumerate(pages, 1):
            page.save(os.path.join(work, f"page-{i:02d}.png"), "PNG")
        pages[0].resize(PEEK_SIZE, Image.LANCZOS).save(os.path.join(work, "peek.png"), "PNG")
        return (work, len(pages)), outcome


# ------------------------------------------------------------- renderer ----

class Renderer:
    def __init__(self):
        shutil.rmtree(CACHE, ignore_errors=True)    # nothing in it outlives a restart
        os.makedirs(CACHE, exist_ok=True)
        os.makedirs(PEEK_DIR, exist_ok=True)
        self.worker = Worker()
        self.busy = None     # the Item being rendered
        self.done = {}       # id -> {"key", "at", "pages": [paths]}
        self.failed = {}     # id -> (key, monotonic time)
        self.refused = {}    # id -> (key, sandboxed): a notice until the item or the sandbox changes
        self.lineup, self.decided_at, self.defaults = [], None, set()
        self.showing = None  # the Item on screen
        self.shown = None    # (id, at) whose pages frame.png is cycling
        self.page, self.next_flip = 0, 0.0
        self.last_bg = 0.0
        self.worker_started = time.monotonic()
        self.bad_since, self.bad_logged = None, False
        self.last_error = None

    # --- results ---------------------------------------------------------
    def install(self, item, result, outcome, elapsed, sandboxed):
        if result is None:
            self.failed[item.id] = (item.key, time.monotonic())
            log(f"render {item.id} {outcome} ({elapsed:.1f}s); keeping its last image")
            return
        work, count = result
        final = os.path.join(CACHE, item.id)
        old = final + ".old"
        shutil.rmtree(old, ignore_errors=True)
        if os.path.isdir(final):
            os.replace(final, old)
        os.replace(work, final)
        shutil.rmtree(old, ignore_errors=True)
        # PEEK_DIR is tmpfs, another filesystem: copy, then rename within it.
        peek = os.path.join(PEEK_DIR, item.id + ".png")
        shutil.copyfile(os.path.join(final, "peek.png"), peek + ".tmp")
        os.replace(peek + ".tmp", peek)
        self.done[item.id] = {"key": item.key, "at": int(time.time()),
                              "pages": [os.path.join(final, f"page-{i:02d}.png") for i in range(1, count + 1)]}
        self.failed.pop(item.id, None)
        if outcome == "ok":
            self.refused.pop(item.id, None)
            log(f"rendered {item.id}: {count} band(s) in {elapsed:.1f}s")
        else:
            self.refused[item.id] = (item.key, sandboxed)
            log(f"render {item.id} {outcome}; showing a notice")
        self.write_index()

    def due(self, item, on_screen):
        refused = self.refused.get(item.id)
        # A refusal stands until the item changes, or the sandbox comes back
        # after one made without it.
        if refused and refused[0] == item.key and (refused[1] or not self.worker.sandboxed):
            return False
        done = self.done.get(item.id)
        failed = self.failed.get(item.id)
        if failed and failed[0] == item.key and time.monotonic() - failed[1] < RETRY_S:
            return False
        if done is None or done["key"] != item.key:
            return True
        age = time.time() - done["at"]
        if item.source:
            return age >= item.source["refresh_s"]
        if item.rev is None:
            return age >= (REGEN if on_screen else PEEK_REGEN)
        return False

    # --- inputs ----------------------------------------------------------
    def poll_pointer(self):
        if PIN_URL:
            self.showing = Item("_pin", PIN_URL)
            return
        pointer, why = fetch_json(POINTER_URL)
        target = target_from(pointer, why)
        if target is None:
            now = time.monotonic()
            self.bad_since = self.bad_since or now
            if self.showing is None and not self.done:
                self.showing = Item("_briefing", BRIEFING_URL, title="Briefing")
            if not self.bad_logged and now - self.bad_since >= STALE_S:
                log(f"pointer unreadable for {STALE_S}s ({why or 'not a usable schema 1 pointer'}),"
                    " keeping the current pages")
                self.bad_logged = True
            return
        if self.bad_logged:
            log("pointer readable again")
        self.bad_since, self.bad_logged = None, False
        self.showing = target

    def poll_lineup(self):
        doc, why = fetch_json(LINEUP_URL)
        if why or not isinstance(doc, dict) or not isinstance(doc.get("items"), list):
            return
        items, seen = [], set()
        for entry in doc["items"]:
            item = item_from(entry)
            if item is not None and item.id not in seen:
                items.append(item)
                seen.add(item.id)
        self.lineup = items
        self.decided_at = doc.get("decided_at") if isinstance(doc.get("decided_at"), str) else None
        self.defaults = {e.get("id") for e in doc["items"]
                         if isinstance(e, dict) and e.get("default") is True and safe_id(e.get("id"))}
        self.prune(seen)
        self.write_index()

    def prune(self, listed):
        """Forget items that left the line-up (and are not on screen)."""
        keep = set(listed) | ({self.showing.id} if self.showing else set())
        for item_id in [i for i in self.done if i not in keep]:
            self.done.pop(item_id, None)
            shutil.rmtree(os.path.join(CACHE, item_id), ignore_errors=True)
        for table in (self.failed, self.refused):
            for item_id in [i for i in table if i not in keep]:
                table.pop(item_id, None)
        for name in os.listdir(PEEK_DIR):
            if name.endswith(".png") and name[:-4] not in listed:
                try:
                    os.unlink(os.path.join(PEEK_DIR, name))
                except OSError:
                    pass

    def write_index(self):
        index = {"schema": 1, "decided_at": self.decided_at, "items": [
            {"id": i.id, "title": i.title, "class": i.cls, "showing": i.showing,
             "image": "/peek/%s.png?v=%d" % (i.id, self.done[i.id]["at"]),
             "as_of": datetime.fromtimestamp(self.done[i.id]["at"], timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")}
            for i in self.lineup if i.id in self.done]}
        text = json.dumps(index, indent=2, ensure_ascii=False) + "\n"
        path = os.path.join(PEEK_DIR, "index.json")
        try:
            with open(path, encoding="utf-8") as f:
                if f.read() == text:
                    return
        except OSError:
            pass
        tmp = path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(text)
        os.replace(tmp, path)

    # --- the screen ------------------------------------------------------
    def frames(self):
        item = self.showing
        done = self.done.get(item.id) if item else None
        if not done:
            return                                    # keep whatever is up until it renders
        now = time.monotonic()
        if self.shown != (item.id, done["at"]):
            self.shown, self.page, self.next_flip = (item.id, done["at"]), 0, 0.0
            log(f"showing {item.id}")
        if now >= self.next_flip:
            pages = done["pages"]
            path = pages[self.page % len(pages)]
            tmp = FRAME + ".tmp"
            try:
                shutil.copyfile(path, tmp)
                os.replace(tmp, FRAME)
            except OSError as exc:
                log(f"could not install {path}: {exc}")
            self.page += 1
            self.next_flip = now + DWELL

    def next_job(self):
        """The item on screen when it is due, else the next due line-up item
        (the default first), spaced BACKGROUND_GAP_S."""
        if self.showing and self.due(self.showing, on_screen=True):
            return self.showing
        if time.monotonic() - self.last_bg < BACKGROUND_GAP_S:
            return None
        for item in sorted(self.lineup, key=lambda i: 0 if i.id in self.defaults else 1):
            if self.showing and item.id == self.showing.id:
                continue
            if self.due(item, on_screen=False):
                self.last_bg = time.monotonic()
                return item
        return None

    def tick(self, now, schedule):
        if now >= schedule["pointer"]:
            schedule["pointer"] = now + POLL
            self.poll_pointer()
        if now >= schedule["lineup"]:
            schedule["lineup"] = now + LINEUP_POLL
            self.poll_lineup()
        if not self.worker.is_alive() and now - self.worker_started >= RETRY_S:
            log("render worker died; starting a new one")
            try:
                self.worker.drop_browser()     # its thread is gone: safe to stop its Chromium
            except Exception as exc:
                log(f"could not stop the old worker's chromium: {exc!r}")
            self.worker = Worker()
            self.worker.start()
            self.worker_started = now
            self.busy = None
        while True:
            try:
                item, result, outcome, elapsed, sandboxed = self.worker.results.get_nowait()
            except queue.Empty:
                break
            self.busy = None
            try:
                self.install(item, result, outcome, elapsed, sandboxed)
            except Exception as exc:     # e.g. the peek directory: back off as for a failed render
                self.failed[item.id] = (item.key, time.monotonic())
                log(f"installing {item.id} failed, retrying in {RETRY_S}s: {exc!r}")
        if self.busy is None:
            job = self.next_job()
            if job is not None:
                self.busy = job
                self.worker.jobs.put(job)
        self.frames()

    def run(self):
        self.worker.start()
        self.worker_started = time.monotonic()
        log(f"brasenia-render: allowed sites: {' '.join(ALLOWED_SITES) or 'none'}")
        schedule = {"pointer": 0.0, "lineup": 0.0}
        while True:
            try:
                self.tick(time.monotonic(), schedule)
                self.last_error = None
            except Exception as exc:     # one bad input must never stop the screen
                if repr(exc) != self.last_error:
                    log(f"tick failed, carrying on: {exc!r}")
                    self.last_error = repr(exc)
            time.sleep(0.25)


def once(urls, source, out):
    """Render URLs in one browser to OUT/NN-band-MM.png and exit: for testing
    (rendering several in turn also tests that each capture is its own page)."""
    worker = Worker()
    os.makedirs(out, exist_ok=True)
    status = 0
    try:
        for n, url in enumerate(urls, 1):
            item = Item(f"once{n}", url, source=clean_source(json.loads(source)) if source else None)
            started = time.monotonic()
            try:
                pages = worker.render(item)
            except Exception as exc:
                print(f"{url}: FAILED: {exc}", file=sys.stderr)
                status = 1
                continue
            for i, page in enumerate(pages, 1):
                page.save(os.path.join(out, f"{n:02d}-band-{i:02d}.png"))
            print(f"{url}: {len(pages)} band(s) in {time.monotonic() - started:.1f}s ({worker.mode()})")
            if worker.browser and worker.browser.blocked:
                print("  blocked: " + ", ".join(sorted(set(worker.browser.blocked))))
    finally:
        worker.drop_browser()
    return status


def main():
    parser = argparse.ArgumentParser(prog="brasenia-render")
    parser.add_argument("--once", nargs="+", metavar="URL")
    parser.add_argument("--source", metavar="JSON", help="with --once: render the URLs as link panes")
    parser.add_argument("--out", default=".", help="with --once: where to write the pages")
    args = parser.parse_args()
    if args.once:
        return once(args.once, args.source, args.out)
    renderer = Renderer()

    def stop(*_):
        renderer.worker.drop_browser()
        os._exit(0)      # the worker thread may be mid-render; the unit restarts us cleanly

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    renderer.run()


if __name__ == "__main__":
    sys.exit(main())
