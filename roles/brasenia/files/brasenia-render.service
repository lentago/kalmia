[Unit]
Description=brasenia renderer: the viewport's panes rendered ahead (frame.png for the stream, /run/brasenia-peek for the remote's peek)
After=network-online.target
Wants=network-online.target brasenia-hls-serve.service

[Service]
User=brasenia
WorkingDirectory=/var/lib/brasenia
EnvironmentFile=/etc/default/brasenia
# tmpfs; kept across restarts so the remote has peek images while it starts.
RuntimeDirectory=brasenia-peek
RuntimeDirectoryPreserve=restart
ExecStart=/usr/local/bin/brasenia-render
# Below the encoder: a render must never starve the live stream.
Nice=5
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
