# lunaria service environment — rendered by ansible (roles/lunaria), do not
# hand-edit; change roles/lunaria/defaults/main.yml and re-run lunaria.yml.
LUNARIA_HOME={{ lunaria_home }}
LUNARIA_PAGES={{ lunaria_home }}/pages
LUNARIA_TV_URL={{ lunaria_tv_url }}
LUNARIA_FULL_URL={{ lunaria_full_url }}
LUNARIA_PAGE_DWELL={{ lunaria_page_dwell }}
LUNARIA_REGEN_INTERVAL={{ lunaria_regen_interval }}
LUNARIA_EXTRA_URLS={{ lunaria_extra_urls | join(' ') }}
LUNARIA_POINTER_URL={{ lunaria_pointer_url }}
LUNARIA_POINTER_POLL={{ lunaria_pointer_poll }}
LUNARIA_PIN_URL={{ lunaria_pin_url }}
LUNARIA_PREFER_RENDITION={{ lunaria_prefer_rendition }}
LUNARIA_SCALE={{ lunaria_scale }}
LUNARIA_FPS={{ lunaria_fps }}
LUNARIA_BITRATE_KBPS={{ lunaria_bitrate_kbps }}
LUNARIA_HLS_PORT={{ lunaria_hls_port }}
