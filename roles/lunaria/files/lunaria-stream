#!/usr/bin/env bash
# Encode the current frame.png into a live HLS stream for the office Roku:
# LUNARIA_FPS fps HEVC + silent AAC, written by ffmpeg's own HLS muxer as
# MPEG-TS segments in /run/lunaria-hls (tmpfs; lunaria-hls-serve serves it).
# HEVC because Roku plays H.264 only up to 1080p. ffmpeg's muxer rather than
# mediamtx because mediamtx's MPEG-TS HLS is H.264-only and its fMP4 HLS
# declares a playlist version (10) the Roku rejects (kalmia#167). One GOP per
# 2s segment; omit_endlist so an encoder restart never leaves a finished
# playlist behind, and epoch-numbered segments so the sequence never runs
# backwards across restarts. The feeder re-cats frame.png per frame, so atomic
# replacements from lunaria-frames appear within one frame. The wall-clock
# overlay doubles as the display's liveness indicator; its size and offsets
# scale with the pages so it stays in the pane contract's clear corner.
set -euo pipefail

HOME_DIR="${LUNARIA_HOME:-/var/lib/lunaria}"
HLS_DIR="${LUNARIA_HLS_DIR:-/run/lunaria-hls}"
SCALE="${LUNARIA_SCALE:-1}"
FPS="${LUNARIA_FPS:-5}"
KBPS="${LUNARIA_BITRATE_KBPS:-6000}"
FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
cd "$HOME_DIR"

for v in SCALE FPS KBPS; do
  if ! [[ "${!v}" =~ ^[1-9][0-9]{0,5}$ ]]; then
    echo "lunaria-stream: $v must be a positive integer, got '${!v}'" >&2
    exit 1
  fi
done
[ -s frame.png ] || { echo "frame.png missing - waiting for lunaria-frames" >&2; exit 1; }
mkdir -p "$HLS_DIR"

# The clock is 28px text in an 8px box, 20px/16px from the corner at 1x.
fs=$(( 28 * SCALE )) bw=$(( 8 * SCALE )) mx=$(( 20 * SCALE )) my=$(( 16 * SCALE ))
gop=$(( FPS * 2 ))
tick=$(awk -v f="$FPS" 'BEGIN { printf "%.3f", 1 / f }')

( while :; do cat frame.png; sleep "$tick"; done ) | \
exec ffmpeg -loglevel warning \
  -f image2pipe -framerate "$FPS" -i - \
  -f lavfi -i "anullsrc=channel_layout=stereo:sample_rate=48000" \
  -vf "drawtext=fontfile=${FONT}:text='%{localtime\:%X}':fontsize=${fs}:fontcolor=white:box=1:boxcolor=black@0.6:boxborderw=${bw}:x=w-tw-${mx}:y=h-th-${my}" \
  -c:v libx265 -preset ultrafast -tune zerolatency \
  -profile:v main -pix_fmt yuv420p -tag:v hvc1 \
  -g "$gop" -keyint_min "$gop" \
  -b:v "${KBPS}k" -maxrate "$(( KBPS * 4 / 3 ))k" -bufsize "$(( KBPS * 2 ))k" \
  -x265-params log-level=error:scenecut=0:repeat-headers=1 \
  -c:a aac -b:a 64k \
  -f hls -hls_time 2 -hls_list_size 7 -hls_segment_type mpegts \
  -hls_flags delete_segments+independent_segments+omit_endlist+temp_file \
  -hls_start_number_source epoch \
  -hls_segment_filename "$HLS_DIR/seg-%d.ts" \
  -master_pl_name master.m3u8 \
  "$HLS_DIR/index.m3u8"
