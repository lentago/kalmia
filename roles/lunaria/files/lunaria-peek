#!/usr/bin/env python3
"""Pre-render the viewport line-up for the Roku remote's peek (lentago/brasenia#80).

The compositor publishes what a person may step through, viewport/lineup.json
(LUNARIA_LINEUP_URL). This keeps one 1920x1080 image per item in
LUNARIA_PEEK_DIR (/run/lunaria-peek): shot with `lunaria-shooter --pane` at
LUNARIA_SCALE, so a pane's desk rendition is preferred just as on the live
stream, then downscaled to 1080p, the Roku UI plane's limit. Beside the images
it writes index.json, the items in line-up order with each image's path and
when it was shot. lunaria-hls-serve serves the directory at /peek/, next to
the stream the Roku already plays.

An item is shot when it has no image, its url changed, or its image is
LUNARIA_PEEK_REGEN seconds old, one at a time, with index.json rewritten
after each so new images show up progressively. The line-up is re-read every
LUNARIA_PEEK_POLL seconds, and images of items that left it are deleted. A
failed shot keeps the previous image. Peeking only looks: nothing here changes
what the stream shows. Each shot gets its own TMPDIR, so it never collides
with lunaria-frames' shooter.
"""
import json, os, re, shutil, subprocess, sys, tempfile, time, urllib.request
from datetime import datetime, timezone
from PIL import Image

LINEUP = os.environ.get("LUNARIA_LINEUP_URL", "http://pub.lan/viewport/lineup.json")
OUT = os.environ.get("LUNARIA_PEEK_DIR", "/run/lunaria-peek")
POLL = int(os.environ.get("LUNARIA_PEEK_POLL", "10"))
REGEN = int(os.environ.get("LUNARIA_PEEK_REGEN", "300"))
SHOOTER = "/usr/local/bin/lunaria-shooter"
SIZE = (1920, 1080)
ID_RE = re.compile(r"_?[a-z0-9][a-z0-9-]{0,62}\Z")   # pane ids, plus the compositor's _briefing


def log(msg):
    print(msg, file=sys.stderr, flush=True)


def iso(epoch):
    return datetime.fromtimestamp(epoch, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def read_lineup():
    req = urllib.request.Request(LINEUP, headers={"Cache-Control": "no-cache"})
    with urllib.request.urlopen(req, timeout=5) as resp:
        doc = json.load(resp)
    items = doc.get("items") if isinstance(doc, dict) else None
    if not isinstance(items, list):
        raise ValueError("no items list")
    return doc, [i for i in items if isinstance(i, dict) and isinstance(i.get("id"), str)
                 and ID_RE.match(i["id"]) and isinstance(i.get("url"), str)]


def shoot(url):
    """The first screen of url as a 1920x1080 image (lunaria-shooter --pane)."""
    work = tempfile.mkdtemp(prefix="lunaria-peek-")
    try:
        env = dict(os.environ, TMPDIR=work, LUNARIA_PAGES=os.path.join(work, "pages"))
        subprocess.run([SHOOTER, "--pane", url], env=env, check=True,
                       capture_output=True, timeout=120)
        with Image.open(os.path.join(work, "pages", "page-01.png")) as im:
            return im.convert("RGB").resize(SIZE, Image.LANCZOS)
    finally:
        shutil.rmtree(work, ignore_errors=True)


def write_atomic(path, write):
    tmp = path + ".tmp"
    write(tmp)
    os.replace(tmp, path)


def write_index(doc, items, shots):
    index = {"schema": 1, "decided_at": doc.get("decided_at"), "items": [
        {"id": i["id"], "title": i.get("title") or i["id"], "class": i.get("class"),
         "showing": bool(i.get("showing")),
         "image": "/peek/%s.png?v=%d" % (i["id"], shots[i["id"]]["at"]),
         "as_of": iso(shots[i["id"]]["at"])}
        for i in items if i["id"] in shots]}
    text = json.dumps(index, indent=2, ensure_ascii=False) + "\n"
    path = os.path.join(OUT, "index.json")
    try:
        with open(path, encoding="utf-8") as f:
            if f.read() == text:
                return
    except OSError:
        pass
    write_atomic(path, lambda p: open(p, "w", encoding="utf-8").write(text))


def load_shots():
    """Seed from a previous run's index (RuntimeDirectoryPreserve=restart)."""
    try:
        with open(os.path.join(OUT, "index.json"), encoding="utf-8") as f:
            items = json.load(f)["items"]
        return {i["id"]: {"url": None, "at": int(i["image"].rsplit("=", 1)[1])} for i in items
                if os.path.exists(os.path.join(OUT, i["id"] + ".png"))}
    except (OSError, ValueError, KeyError, TypeError, IndexError, AttributeError):
        return {}


def main():
    os.makedirs(OUT, exist_ok=True)
    shots = load_shots()   # id -> {"url": url shot (None if unknown), "at": epoch}
    unreadable = False
    while True:
        try:
            doc, items = read_lineup()
        except Exception as exc:
            if not unreadable:
                log("line-up unreadable (%s); keeping the current images" % exc)
                unreadable = True
            time.sleep(POLL)
            continue
        if unreadable:
            log("line-up readable again")
            unreadable = False
        listed = {i["id"] for i in items}
        for gone in [k for k in shots if k not in listed]:
            del shots[gone]
            try:
                os.unlink(os.path.join(OUT, gone + ".png"))
            except OSError:
                pass
        write_index(doc, items, shots)
        for item in items:
            prev = shots.get(item["id"])
            if prev and prev["url"] in (None, item["url"]) and time.time() - prev["at"] < REGEN:
                continue
            try:
                image = shoot(item["url"])
            except Exception as exc:
                log("peek %s: shot failed (%s); keeping the previous image" % (item["id"], exc))
                continue
            write_atomic(os.path.join(OUT, item["id"] + ".png"), lambda p: image.save(p, "PNG"))
            shots[item["id"]] = {"url": item["url"], "at": int(time.time())}
            write_index(doc, items, shots)
        time.sleep(POLL)


if __name__ == "__main__":
    main()
