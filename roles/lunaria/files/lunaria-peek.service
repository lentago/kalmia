[Unit]
Description=lunaria peek renderer (viewport line-up -> /run/lunaria-peek for the Roku remote)
After=network-online.target
Wants=network-online.target lunaria-hls-serve.service

[Service]
User=lunaria
WorkingDirectory=/var/lib/lunaria
EnvironmentFile=/etc/default/lunaria
# tmpfs; kept across restarts so the remote has images while it re-reads.
RuntimeDirectory=lunaria-peek
RuntimeDirectoryPreserve=restart
ExecStart=/usr/local/bin/lunaria-peek
# Below the encoder: a peek shot must never starve the live stream.
Nice=10
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
