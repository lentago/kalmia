[Unit]
Description=lunaria encoder (frame.png -> HEVC HLS in /run/lunaria-hls)
After=network-online.target lunaria-frames.service
Wants=network-online.target lunaria-frames.service lunaria-hls-serve.service

[Service]
User=lunaria
WorkingDirectory=/var/lib/lunaria
EnvironmentFile=/etc/default/lunaria
# tmpfs: ~2 MB of segments every 2 s never touches the disk. Removed on each
# restart, so a stale playlist is never served across one.
RuntimeDirectory=lunaria-hls
ExecStart=/usr/local/bin/lunaria-stream
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
