#!/usr/bin/env python3
"""Serve lunaria-stream's HLS output (/run/lunaria-hls) and brasenia-render's
peek images (/run/lunaria-peek) to the Roku.

Two flat directories, GET/HEAD only:

- /<name>: *.m3u8 playlists (sent no-cache, since a live playlist changes
  every segment) and *.ts segments. The stream URL is
  http://<host>:LUNARIA_HLS_PORT/master.m3u8.
- /peek/<name>: the remote's peek, index.json (no-cache) and *.png images
  (lentago/brasenia#80).

Everything else - ffmpeg's in-progress *.tmp files, directory listings, any
other path or extension - is a 404, so a reader never sees a half-written
file or anything outside the two directories. Stdlib only, LAN-only and
credential-free like the rest of LXC 118.
"""
import http.server, os

DIRS = {
    "": (os.environ.get("LUNARIA_HLS_DIR", "/run/lunaria-hls"),
         {".m3u8": "application/vnd.apple.mpegurl", ".ts": "video/mp2t"}),
    "peek": (os.environ.get("LUNARIA_PEEK_DIR", "/run/lunaria-peek"),
             {".json": "application/json", ".png": "image/png"}),
}
PORT = int(os.environ.get("LUNARIA_HLS_PORT", "8080"))
NO_CACHE = (".m3u8", ".json")


class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        self.reply(body=True)

    def do_HEAD(self):
        self.reply(body=False)

    def reply(self, body):
        prefix, _, name = self.path.split("?", 1)[0].lstrip("/").rpartition("/")
        directory, types = DIRS.get(prefix, (None, {}))
        ext = os.path.splitext(name)[1]
        if directory is None or not name or ext not in types:
            self.send_error(404)
            return
        try:
            with open(os.path.join(directory, name), "rb") as f:
                data = f.read()
        except OSError:
            self.send_error(404)
            return
        self.send_response(200)
        self.send_header("Content-Type", types[ext])
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-cache" if ext in NO_CACHE else "max-age=60")
        self.end_headers()
        if body:
            self.wfile.write(data)

    def log_message(self, *args):
        pass   # a playing Roku fetches every 2 s; errors still reach stderr


http.server.ThreadingHTTPServer(("", PORT), Handler).serve_forever()
