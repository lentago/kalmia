#!/usr/bin/env bash
# clean-all — Force-delete every local branch except the default in each repo
# under {{ repos_dir }}, then pull. Useful after a wave of merged PRs.
# Dependencies: git
# Usage: clean-all
#   REPOS_DIR   override the directory to scan (default: {{ repos_dir }})
#
# DESTRUCTIVE: branches are removed with `git branch -D`, which does not care
# whether their commits are merged or pushed anywhere. That is deliberate — the
# fleet squash-merges, so `git branch -d` refuses to delete the branch behind a
# merged PR (its commits never appear in the default branch). The cost is that an
# unpushed branch is indistinguishable from a squash-merged one. Run pull-all if
# you only want to update; run this when you mean to discard local branches.
#
# ANSIBLE MANAGED — kalmia roles/shell. Local edits are overwritten on the next
# run; change roles/shell/templates/clean-all.j2 instead.
set -euo pipefail

REPOS_DIR="${REPOS_DIR:-{{ repos_dir }}}"

if [[ ! -d "$REPOS_DIR" ]]; then
    printf '\033[1;33mclean-all: %s does not exist\033[0m\n' "$REPOS_DIR" >&2
    echo "Set clone_repos=true and re-run the play, or point REPOS_DIR at your checkouts." >&2
    exit 1
fi

ok=0
unchanged=0
fail=0

for dir in "$REPOS_DIR"/*/; do
    [[ -d "$dir/.git" ]] || continue
    name=$(basename "$dir")

    default=$(git -C "$dir" symbolic-ref refs/remotes/origin/HEAD --short 2>/dev/null | sed 's|^origin/||' || true)
    if [[ -z "$default" ]] || ! git -C "$dir" checkout --quiet "$default" 2>/dev/null; then
        printf '\033[1;33m  ⚠ %s (check manually)\033[0m\n' "$name"
        fail=$((fail + 1))
        continue
    fi

    removed=0
    while IFS= read -r branch; do
        [[ -z "$branch" || "$branch" == "$default" ]] && continue
        if git -C "$dir" branch -D "$branch" >/dev/null 2>&1; then
            removed=$((removed + 1))
        fi
    done < <(git -C "$dir" branch --format='%(refname:short)')

    before=$(git -C "$dir" rev-parse HEAD 2>/dev/null || echo "")
    if ! git -C "$dir" pull --rebase --quiet 2>/dev/null; then
        printf '\033[1;33m  ⚠ %s (%s, removed %d, pull failed)\033[0m\n' "$name" "$default" "$removed"
        fail=$((fail + 1))
        continue
    fi
    after=$(git -C "$dir" rev-parse HEAD)

    if [[ "$before" == "$after" ]]; then
        printf '\033[0;32m  ✓\033[0m %s (%s, removed %d, up to date)\n' "$name" "$default" "$removed"
        unchanged=$((unchanged + 1))
    else
        printf '\033[0;32m  ✓\033[0m %s (%s, removed %d)\n' "$name" "$default" "$removed"
        git -C "$dir" --no-pager diff --stat "$before..$after" | sed 's/^/      /'
        ok=$((ok + 1))
    fi
done

echo ""
echo "Cleaned: $ok updated, $unchanged unchanged, $fail need attention"
