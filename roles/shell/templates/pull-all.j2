#!/usr/bin/env bash
# pull-all — Switch every repo under {{ repos_dir }} to its default branch and pull.
# Dependencies: git
# Usage: pull-all
#   REPOS_DIR   override the directory to scan (default: {{ repos_dir }})
#
# ANSIBLE MANAGED — kalmia roles/shell. Local edits are overwritten on the next
# run; change roles/shell/templates/pull-all.j2 instead.
set -euo pipefail

REPOS_DIR="${REPOS_DIR:-{{ repos_dir }}}"

if [[ ! -d "$REPOS_DIR" ]]; then
    printf '\033[1;33mpull-all: %s does not exist\033[0m\n' "$REPOS_DIR" >&2
    echo "Set clone_repos=true and re-run the play, or point REPOS_DIR at your checkouts." >&2
    exit 1
fi

ok=0
unchanged=0
fail=0

# Checkouts are owner-grouped (<owner>/<name>); flat <name>/ still works.
for dir in "$REPOS_DIR"/*/ "$REPOS_DIR"/*/*/; do
    [[ -d "$dir/.git" ]] || continue
    name=${dir#"$REPOS_DIR"/}; name=${name%/}

    default=$(git -C "$dir" symbolic-ref refs/remotes/origin/HEAD --short 2>/dev/null | sed 's|^origin/||' || true)
    if [[ -z "$default" ]] || ! git -C "$dir" checkout --quiet "$default" 2>/dev/null; then
        printf '\033[1;33m  ⚠ %s (check manually)\033[0m\n' "$name"
        fail=$((fail + 1))
        continue
    fi

    before=$(git -C "$dir" rev-parse HEAD 2>/dev/null || echo "")
    if ! git -C "$dir" pull --rebase --quiet 2>/dev/null; then
        printf '\033[1;33m  ⚠ %s (check manually)\033[0m\n' "$name"
        fail=$((fail + 1))
        continue
    fi
    after=$(git -C "$dir" rev-parse HEAD)

    if [[ "$before" == "$after" ]]; then
        printf '\033[0;32m  ✓\033[0m %s (%s, up to date)\n' "$name" "$default"
        unchanged=$((unchanged + 1))
    else
        printf '\033[0;32m  ✓\033[0m %s (%s)\n' "$name" "$default"
        git -C "$dir" --no-pager diff --stat "$before..$after" | sed 's/^/      /'
        ok=$((ok + 1))
    fi
done

echo ""
echo "Pulled: $ok updated, $unchanged unchanged, $fail need attention"
