{# Body is a verbatim copy of the script wrapped in raw: it uses `${#x[@]}` (array length) throughout, which Jinja would read as a comment opener. Only the REPOS_DIR default and the colour map (HUE, DIRECTOR_ACCENT) are templated. Keep `-%}` on the raw tag or the shebang lands on line 2. #}
{% raw -%}
#!/usr/bin/env bash
# standing — start and tend a standing interactive Claude Code session in a
# Lentago repo, each in its own maximized terminal. Every session is one window
# of tmux session "lentago", named after its repo and holding one pane that
# runs `claude --name <repo>-standing` in that repo's checkout. Each window is
# viewed through its own grouped tmux session ("lentago-<repo>") with its own
# terminal, titled "<repo> — standing EM" at the terminal's normal font size, so
# a human finds a session by name in the window switcher and nothing runs hidden.
# Closing a terminal (or `standing hide <repo>`) only detaches a tmux client: the
# EM keeps running, and `standing show <repo>` brings its terminal back.
#
# Org model (see ~/repos/lentago/CLAUDE.md): the session at ~/repos/lentago is
# the Engineering Director; each standing session is that repo's Engineering
# Manager (EM), on Sonnet by default, free to spawn subagents of its own choice;
# Chris is Product Owner, CTO and CEO. EMs start on demand: the Director runs
# `standing up <repo>` the first time a dispatch needs that EM, never for every
# repo at init, so a normal day grows from zero EMs to the handful it dispatches to.
#
# The Director lives on the same tmux server, in its own tmux session
# "lentago-director": one window "director" in ~/repos/lentago running
# `claude --name lentago-director --continue`, so it survives a closed terminal,
# keeps a stable name for the EMs to report to, and resumes its conversation.
# `standing director` (or the `director` command) creates or resumes it and
# attaches. While that session exists, `standing up` points new EMs at it.
#
# Sessions outside tmux: a Director or EM can also run where standing did not start
# it (the VS Code extension, the desktop app, a plain terminal). standing reads
# Claude Code's session records (~/.claude/sessions) to see them: `status` lists
# them, `up` points new EMs at an outside Director, and `director`/`up` warn before
# starting a second session under a name that is already live (kalmia#291).
#
# Dependencies: tmux (>= 3.2), claude, coreutils; ghostty/ptyxis/alacritty for `open`;
# python3 to read the session records (without it standing sees only its own panes)
#
# Usage:
#   standing                       same as `standing status`
#   standing up REPO [REPO ...]    start these EMs, a window and a terminal each —
#                                  idempotent: a running EM is left alone, a dead one is
#                                  respawned in place; a terminal opens only for an EM
#                                  this run starts or respawns, so one closed on purpose
#                                  stays closed (`open` fills them); others are not touched
#   standing up                    with no repos: every repo, in ORDER below (explicit use only)
#   standing up REPO --director NAME  tell the EM which session is its Director (NAME from
#                                  the "This session is …" line of ListAgents); remembered
#                                  for later up/restart calls — `--no-director` forgets it.
#                                  With no --director, the EM reports to lentago-director
#                                  while that tmux session exists, else to the remembered one
#   standing up --no-open ...      don't open terminal windows
#   standing up --no-prompt ...    start claude at an empty prompt (no kickoff turn)
#   standing up --prompt 'text'    custom kickoff prompt
#   standing up kalmia -- --model opus   anything after `--` is passed to claude
#   standing restart [repo ...] [same flags as up]
#                                  /exit each pane and start a FRESH session in it (new model,
#                                  prompt, director); the EM's conversation and any in-flight
#                                  work are gone. Windows and terminals stay put. A bare
#                                  `standing restart` keeps the Director: lentago-director
#                                  while that session exists, else the one remembered from
#                                  the last --director.
#   standing down [repo ...]       send /exit, wait, then kill the EM's pane, window and
#                                  terminal; with no repos: every EM, then the EMs' tmux
#                                  sessions — never the Director's
#   standing down director         /exit the Director, then end its tmux session and terminals.
#                                  The remembered Director name is kept: EMs started meanwhile
#                                  still report to lentago-director, which `director` brings back
#   standing status                the Director's row, then one row per EM: repo, state,
#                                  terminal, pid, size, session name (state "trust?" = waiting
#                                  at Claude's folder-trust dialog); then any live Claude
#                                  session outside these panes: name, state, where it runs
#                                  (cli, vscode, desktop), pid and role (director, em, ad-hoc
#                                  for a session in a repo below the repos dir, other)
#   standing trust [repo ...] [--yes]  list the EMs waiting at the folder-trust dialog and,
#                                  after a y/N prompt (or --yes), accept it in each — your
#                                  call to run; these are your repos and Claude won't run it for you
#   standing show REPO             open one maximized terminal on that EM's window, titled
#                                  "REPO — standing EM"; if a terminal already shows it, says
#                                  so and opens nothing
#   standing hide REPO             close that EM's terminal(s); its pane and claude keep running
#                                  (in a grid window, that terminal shows its neighbours too)
#   standing director [--open] [--fresh] [-- claude args]
#                                  create the Director's tmux session or, if its claude has
#                                  exited, respawn it in place; then attach this terminal
#                                  (switch-client inside tmux). A running Director is left
#                                  alone, never started twice. --open: instead of attaching,
#                                  open a maximized terminal titled "lentago — Engineering
#                                  Director" unless one already shows it. --fresh: start a new
#                                  conversation instead of --continue (only when it starts or
#                                  respawns claude). The `director` command is this.
#   standing show|hide director    open or close the Director's terminal, as for an EM
#   standing open                  open a maximized terminal for every EM window that has none,
#                                  including ones closed on purpose (`show REPO` opens just one)
#   standing attach [repo]         attach in *this* terminal (or switch-client inside tmux) to
#                                  the base session, which holds every EM window
#                                  (`attach director` attaches to the Director's session)
#   standing tile                  re-apply the tiled layout (matters only with STANDING_PER_WINDOW > 1)
#   standing repos                 print the repo set a bare `up` would use, in ORDER
#
# Each terminal shows one EM; the tmux status line lists every EM window. To look
# across them from one terminal, `standing attach` and pick with prefix+w (Ctrl-b w).
# GNOME places new windows on the active monitor — Super+Shift+Arrow moves one.
#
# Environment:
#   STANDING_REPOS_DIR     where the clones live   (default: ~/repos/lentago)
#   STANDING_TMUX_SESSION  tmux session name       (default: lentago)
#   STANDING_DIRECTOR_NAME the Director's tmux session and claude --name
#                                                  (default: lentago-director)
#   STANDING_REMOTE_CONTROL  1 (default): every EM and the Director start with
#                          `--remote-control <their --name>`, so they show up by name in
#                          the claude.ai session list; set 0 to disable. A
#                          `--remote-control*` passed after `--` takes precedence.
#   STANDING_PER_WINDOW    EMs per window          (default: 1 — a window and terminal each;
#                          N > 1 packs N tiled panes into windows standing-1, standing-2, …)
#   STANDING_MODEL         model every EM starts on (default: claude-sonnet-5-5; set it
#                          empty for Claude's own default; `-- --model X` overrides per run)
#   STANDING_NAME_SUFFIX   claude --name suffix    (default: standing → "kalmia-standing")
#   STANDING_TERMINAL      terminal for `open`     (default: first of ghostty, ptyxis, alacritty)
#   STANDING_FONT_SIZE     font size for those terminals only (ghostty/alacritty; default:
#                          unset, i.e. the terminal's own size)
#   STANDING_EXIT_WAIT     seconds `down`/`restart` wait after /exit before killing (default: 20)
#
# Notes:
#   * First launch in a repo Claude has never opened shows the folder-trust dialog
#     and waits there — `standing status` shows it as "trust?"; `standing trust` accepts.
#   * Panes keep remain-on-exit, so a crashed claude leaves its last screen
#     readable ("[dead]" on the border); `standing up` respawns it in place.
#   * Inherited CLAUDE* env vars are stripped from the children, so this can be
#     run from inside another Claude session without tripping nested-session guards.
#   * The base session "lentago" holds every EM window and remembers the Director,
#     and is never itself a view: window <repo> is viewed through "lentago-<repo>",
#     one session group sharing the windows. `down` with no repos removes them all.
#   * "lentago-director" is not in that group, so nothing aimed at the EMs touches
#     it; its pane keeps remain-on-exit too, and `standing director` respawns it.
#   * Windows standing-1, standing-2, … (the earlier tiled grid, or STANDING_PER_WINDOW
#     > 1) are still listed, restarted and downed; window N is viewed through
#     "lentago-vN". (Before kalmia#249, window 1 was viewed through the base session;
#     a terminal still attached there is not counted as showing it.)
#   * Colours tell level and repo apart at a glance (kalmia#265). An EM's pane has a
#     dark tint of its repo's hue, and its border and status line a bright accent;
#     the Director keeps the plain background and gets a gold frame. All of it is set
#     in tmux, so it is the same in any terminal; ghostty also gets the tint for its
#     padding. Hues come from `standing_colors` in roles/shell defaults; `up`, `show`
#     and `director` re-apply them, so a running session repaints after a change.
#   * ANSIBLE MANAGED — kalmia roles/shell (like clean-all/pull-all). Local edits
#     are overwritten on the next run; change roles/shell/templates/standing.j2 instead.
set -euo pipefail

REPOS_DIR="${STANDING_REPOS_DIR:-{% endraw %}{{ repos_dir }}/lentago{% raw %}}"
TMUX_SESSION="${STANDING_TMUX_SESSION:-lentago}"
DIRECTOR_NAME="${STANDING_DIRECTOR_NAME:-lentago-director}"
DIRECTOR_WIN=director
DIRECTOR_TITLE="lentago — Engineering Director"
PER_WINDOW="${STANDING_PER_WINDOW:-1}"
MODEL="${STANDING_MODEL-claude-sonnet-5-5}"
NAME_SUFFIX="${STANDING_NAME_SUFFIX:-standing}"
REMOTE_CONTROL="${STANDING_REMOTE_CONTROL:-1}"
EXIT_WAIT="${STANDING_EXIT_WAIT:-20}"
WIN_PREFIX="standing"   # grid windows: standing-1, standing-2, … (PER_WINDOW > 1, or older runs)
# Size a window has while no terminal is attached (so splits always fit);
# it follows the attached terminal's size afterwards.
DEF_W=320; DEF_H=100
# Field separator for tmux -F output: a tab is IFS whitespace and collapses when
# a field is empty (an untagged pane), shifting columns; this never does.
US=$'\x1f'

# Order a bare `standing up` starts repos in (and, with PER_WINDOW > 1, how they
# group into windows): platform first, then products/guides/sites, then the
# uvularia family. A repo not listed here comes after these, alphabetically.
ORDER=(
    claytonia drosera kalmia brasenia dotgithub betula solidago shared-workflows
    asclepias lupinus epigaea mitchella monarda osmunda site-lentago-dev site-icecreamtofightwith-com
    site-pondviewlane-com uvularia uvularia-records-template uvularia-rules-template
    uvularia-site-template uvularia-demo-records uvularia-demo-ask-rules uvularia-demo-site
)
# Never started: archived on GitHub, or a template nobody works in.
EXCLUDE=(coderabbit office-presence site-pitzilabs-dev workstation-bootstrap repo-template)

# Kickoff turn for each pane. %DIRECTOR% is replaced with the --director sentence (or nothing).
KICKOFF_DEFAULT='You are the Engineering Manager for this repo (see the org model in ~/repos/lentago/CLAUDE.md). %DIRECTOR%Chris is Product Owner, CTO and CEO. You may spawn subagents of your own choice (Haiku, Sonnet, Opus) for parallel or read-only work; their judgments come back through you. Introduce yourself per your CLAUDE.md, call ListAgents once so you know your peers, then stand by. Do not start any work until asked.'
# shellcheck disable=SC2016  # backticks are markdown in the prompt, not a command
DIRECTOR_SENTENCE='Your Engineering Director is the session named `%NAME%`; report to it with SendMessage when work is done or blocked. '

# Colours (kalmia#265). HUE is rendered from `standing_colors` in roles/shell
# defaults: a hue in degrees, or `neutral` for a grey. A repo not in it gets a
# stable hue hashed from its name (repo_colors), so a new repo needs no edit.
{% endraw %}
declare -A HUE=(
{% for repo, hue in standing_colors | dictsort %}
    [{{ repo }}]='{{ hue }}'
{% endfor %}
)
DIRECTOR_ACCENT='{{ standing_director_accent }}'
{% raw -%}
EMBER='#1d120d'            # the terminals' own background: the Director's status text on gold
TINT_S=38; TINT_L=8        # HSL saturation and lightness (%) of an EM's pane tint: about ember's
ACCENT_S=65; ACCENT_L=60   # and of its accent (border, status line)

# ---------------------------------------------------------------- helpers ----

c_ok=$'\033[0;32m'; c_warn=$'\033[1;33m'; c_err=$'\033[1;31m'; c_dim=$'\033[2m'; c_off=$'\033[0m'
say()  { printf '%s\n' "$*"; }
ok()   { printf '%s  ✓%s %s\n' "$c_ok" "$c_off" "$*"; }
warn() { printf '%s  ⚠ %s%s\n' "$c_warn" "$*" "$c_off" >&2; }
die()  { printf '%sstanding: %s%s\n' "$c_err" "$*" "$c_off" >&2; exit 1; }

need() { command -v "$1" >/dev/null 2>&1 || die "$1 not found on PATH"; }

# Strip every CLAUDE* variable from our own environment so a tmux server we
# start does not carry a parent session's identity into the children.
# (Hence no script variable may start with CLAUDE — e.g. CLI_BIN, not CLAUDE_BIN.)
scrub_env() {
    local v
    while IFS= read -r v; do unset "$v"; done < <(compgen -v | grep -E '^CLAUDE' || true)
}

has_session() { tmux has-session -t "=$TMUX_SESSION" 2>/dev/null; }

# Standing windows, in window order: every window this script made (tagged
# @standing) plus grid windows standing-N from runs before the tag existed.
std_windows() {
    has_session || return 0
    tmux list-windows -t "=$TMUX_SESSION" -F "#{window_name}${US}#{@standing}" 2>/dev/null \
        | awk -F"$US" -v p="^${WIN_PREFIX}-[0-9]+$" '$2 == 1 || $1 ~ p { print $1 }' || true
}
# The grid windows among them (standing-1, standing-2, …), in numeric order.
grid_windows() { std_windows | grep -E "^${WIN_PREFIX}-[0-9]+$" | sort -t- -k2,2n || true; }
is_grid()   { [[ "$1" =~ ^${WIN_PREFIX}-[0-9]+$ ]]; }
# A repo's own window is named after it; tmux reads '.' and ':' in a target as
# separators, so those become '_'. A repo named like a grid window (standing-N)
# or its view (vN, as in "lentago-vN") gets a leading '_', so neither collides.
win_name() {
    local n=${1//[.:]/_}
    [[ "$n" =~ ^(v|${WIN_PREFIX}-)[0-9]+$ ]] && n="_$n"
    printf '%s' "$n"
}
win_t()     { printf '=%s:=%s' "$TMUX_SESSION" "$1"; }              # exact window target
win_num()   { printf '%s' "${1##*-}"; }
win_panes() { tmux list-panes -t "$(win_t "$1")" -F '#{pane_id}' 2>/dev/null | wc -l; }
# The grouped session through which a window is viewed: "lentago-<repo>" for a
# repo's own window, "lentago-vN" for grid window N. Never the base session, so
# a `standing attach` client is never mistaken for an EM's terminal.
view_for() {
    if is_grid "$1"; then
        printf '%s-v%s' "$TMUX_SESSION" "$(win_num "$1")"
    else
        printf '%s-%s' "$TMUX_SESSION" "$1"
    fi
}
# The inverse, from a view session's name; empty for the base session.
view_window() {
    [[ "$1" == "$TMUX_SESSION"-* ]] || return 0
    local rest=${1#"$TMUX_SESSION"-}
    if [[ "$rest" =~ ^v([0-9]+)$ ]]; then printf '%s-%s' "$WIN_PREFIX" "${BASH_REMATCH[1]}"; else printf '%s' "$rest"; fi
}
# The base session and every session grouped with it. Matched on the group, not
# on a name prefix, so another standing session ("lentago-test") is never caught.
view_sessions() {
    tmux list-sessions -F "#{session_name}${US}#{session_group}" 2>/dev/null \
        | awk -F"$US" -v s="$TMUX_SESSION" '$1 == s || $2 == s { print $1 }' || true
}
# Terminals attached to a session; 0 when the session doesn't exist yet (an EM
# started with --no-open has no view), which under pipefail must not fail.
clients_of() { { tmux list-clients -t "=$1" 2>/dev/null || true; } | wc -l; }

# window US pane_id US repo for every pane in every standing window.
all_panes() {
    has_session || return 0
    tmux list-panes -s -t "=$TMUX_SESSION" -F "#{window_name}${US}#{pane_id}${US}#{@repo}${US}#{@standing}" 2>/dev/null \
        | awk -F"$US" -v OFS="$US" -v p="^${WIN_PREFIX}-[0-9]+$" '$4 == 1 || $1 ~ p { print $1, $2, $3 }' || true
}
pane_for()    { all_panes | awk -F"$US" -v r="$1" '$3 == r { print $2; exit }'; }
window_of()   { all_panes | awk -F"$US" -v id="$1" '$2 == id { print $1; exit }'; }
pane_dead()   { [[ "$(tmux display-message -p -t "$1" '#{pane_dead}' 2>/dev/null)" == 1 ]]; }
pane_exists() { tmux display-message -p -t "$1" '#{pane_id}' >/dev/null 2>&1; }
# Claude's first-run folder-trust dialog is on screen: both options as whole
# lines plus the confirm hint, so a pane merely quoting the sentence doesn't match.
at_trust_prompt() {
    local screen
    screen=$(tmux capture-pane -p -t "$1" 2>/dev/null) || return 1
    grep -qE '^ *(❯ +)?No, exit *$' <<<"$screen" \
        && grep -qE '^ *(❯ +)?Yes, I trust this folder *$' <<<"$screen" \
        && grep -qF 'Enter to confirm' <<<"$screen"
}
trust_cursor_on_yes() { tmux capture-pane -p -t "$1" 2>/dev/null | grep -qE '^ *❯ +Yes, I trust this folder *$'; }

in_exclude() { local r; for r in "${EXCLUDE[@]}"; do [[ "$r" == "$1" ]] && return 0; done; return 1; }

# Every git clone under REPOS_DIR minus EXCLUDE, in ORDER (unknowns last, sorted).
all_repos() {
    local -A have=()
    local d n r
    for d in "$REPOS_DIR"/*/; do
        [[ -d "$d/.git" ]] || continue
        n=$(basename "$d")
        in_exclude "$n" || have[$n]=1
    done
    for r in "${ORDER[@]}"; do
        [[ -n "${have[$r]:-}" ]] || continue
        printf '%s\n' "$r"; unset "have[$r]"
    done
    (( ${#have[@]} == 0 )) || printf '%s\n' "${!have[@]}" | sort
}

# Populate REPOS from args: explicit names, or everything.
resolve_repos() {
    local r
    REPOS=()
    for r in "$@"; do
        case "$r" in
            --all) ;;                      # accepted for old habits; it is the default
            -*)    die "unknown option: $r" ;;
            *)     REPOS+=("$r") ;;
        esac
    done
    (( ${#REPOS[@]} )) || mapfile -t REPOS < <(all_repos)
    for r in "${REPOS[@]}"; do
        [[ -d "$REPOS_DIR/$r/.git" ]] || die "$REPOS_DIR/$r is not a git checkout"
    done
}

# The Director's session name is remembered on the base tmux session so later
# `up`/`restart` calls without --director keep pointing the EMs at it.
remember_director() { has_session && tmux set-option -t "$TMUX_SESSION:" @director "$1" 2>/dev/null || true; }
forget_director()   { has_session && tmux set-option -qu -t "$TMUX_SESSION:" @director 2>/dev/null || true; }
recall_director()   { has_session && tmux show-options -qv -t "$TMUX_SESSION:" @director 2>/dev/null || true; }

# Flags shared by `up` and `restart`: sets PROMPT, USE_PROMPT, OPEN, DIRECTOR,
# SEL (repo names) and EXTRA (args after --). DIRECTOR falls back to the
# remembered one; call remember_director after the session exists.
parse_launch_flags() {
    PROMPT="$KICKOFF_DEFAULT"; USE_PROMPT=1; OPEN=1; DIRECTOR=""; NO_DIRECTOR=0; SEL=(); EXTRA=()
    while (( $# )); do
        case "$1" in
            --no-prompt)  USE_PROMPT=0; shift ;;
            --no-director) NO_DIRECTOR=1; shift ;;
            --no-open)    OPEN=0; shift ;;
            --director)   [[ $# -ge 2 ]] || die "--director needs a session name"; DIRECTOR=$2; shift 2 ;;
            --director=*) DIRECTOR=${1#--director=}; shift ;;
            --prompt)     [[ $# -ge 2 ]] || die "--prompt needs a value"; PROMPT=$2; shift 2 ;;
            --prompt=*)   PROMPT=${1#--prompt=}; shift ;;
            --)           shift; EXTRA=("$@"); break ;;
            *)            SEL+=("$1"); shift ;;
        esac
    done
    local s
    for s in "${SEL[@]}"; do
        [[ "$s" != director ]] || die "the Director is started with 'standing director' (the 'director' command), not as an EM"
    done
    if (( NO_DIRECTOR )); then
        DIRECTOR=""
    elif [[ -z "$DIRECTOR" ]]; then
        # A live Director, in tmux or outside it (kalmia#291), outranks a remembered
        # name: that is how EMs started after the switch stop pointing at an old session.
        if director_up || [[ -n "$(outside_pid_of "$DIRECTOR_NAME")" ]]; then
            DIRECTOR=$DIRECTOR_NAME
        else
            DIRECTOR=$(recall_director)
        fi
    fi
    local dsent=""
    [[ -n "$DIRECTOR" ]] && dsent=${DIRECTOR_SENTENCE//%NAME%/$DIRECTOR}
    PROMPT=${PROMPT//%DIRECTOR%/$dsent}
}

# `env -u VAR …` for every CLAUDE* variable in the tmux server's global
# environment (it may predate this script). Prints NUL-separated.
env_prefix() {
    local v
    printf '%s\0' env
    while IFS= read -r v; do printf '%s\0' -u "$v"; done \
        < <(tmux show-environment -g 2>/dev/null | grep -oE '^CLAUDE[A-Za-z0-9_]*' || true)
}

# Remote Control flag for a session named $1, unless disabled or the caller
# already passed their own --remote-control* after `--`. Prints NUL-separated.
remote_control_args() {
    local a
    [[ "$REMOTE_CONTROL" == 0 ]] && return 0
    for a in "${EXTRA[@]}"; do
        [[ "$a" == --remote-control* ]] && return 0
    done
    printf '%s\0' --remote-control "$1"
}

# Build the argv that runs claude in a pane: CLAUDE* stripped from the tmux
# server's global environment too (it may predate this script), the default
# model unless the caller passed one, then the caller's extras and the prompt.
# Prints NUL-separated.
claude_argv() {
    local repo=$1; shift
    local -a cmd=()
    local a has_model=0
    mapfile -d '' cmd < <(env_prefix)
    cmd+=("$CLI_BIN" --name "$repo-$NAME_SUFFIX")
    mapfile -d '' -O "${#cmd[@]}" cmd < <(remote_control_args "$repo-$NAME_SUFFIX")
    for a in "${EXTRA[@]}"; do [[ "$a" == --model || "$a" == --model=* ]] && has_model=1; done
    [[ -n "$MODEL" && $has_model == 0 ]] && cmd+=(--model "$MODEL")
    cmd+=("${EXTRA[@]}")
    (( USE_PROMPT )) && cmd+=("$PROMPT")
    printf '%s\0' "${cmd[@]}"
}

# The model an EM actually gets: a `--model X` / `--model=X` passed after `--`
# wins over the default, same as claude_argv. Prints nothing when neither is set.
effective_model() {
    local i
    for (( i = 0; i < ${#EXTRA[@]}; i++ )); do
        case "${EXTRA[i]}" in
            --model)   printf '%s' "${EXTRA[i+1]:-}"; return ;;   # bare/empty: claude_argv adds no default either
            --model=*) printf '%s' "${EXTRA[i]#--model=}"; return ;;
        esac
    done
    printf '%s' "$MODEL"
}

# Create the pane for a repo (creating the session as needed); prints its id.
# PER_WINDOW 1: a new window named after the repo. PER_WINDOW > 1: the first
# grid window with room, else the next grid window standing-N.
spawn_pane() {
    local repo=$1 dir=$2; shift 2
    local id w name target="" last n
    if (( PER_WINDOW == 1 )); then
        name=$(win_name "$repo")
    else
        for w in $(grid_windows); do
            if (( $(win_panes "$w") < PER_WINDOW )); then target=$w; break; fi
        done
        last=$(grid_windows | tail -n1)
        n=1; [[ -n "$last" ]] && n=$(( $(win_num "$last") + 1 ))
        name="$WIN_PREFIX-$n"
    fi
    if [[ -n "$target" ]]; then
        id=$(tmux split-window -d -P -F '#{pane_id}' -t "$(win_t "$target")" -c "$dir" -- "$@")
    elif ! has_session; then
        id=$(tmux new-session -d -P -F '#{pane_id}' -s "$TMUX_SESSION" -n "$name" \
                -x "$DEF_W" -y "$DEF_H" -c "$dir" -- "$@")
    else
        id=$(tmux new-window -d -P -F '#{pane_id}' -t "=$TMUX_SESSION:" -n "$name" -c "$dir" -- "$@")
    fi
    tmux set-option -w -t "$id" @standing 1
    tmux set-option -p -t "$id" @repo "$repo"
    printf '%s' "$id"
}

# Escape clears any dialog or half-typed input, then a clean /exit; waits up to
# EXIT_WAIT seconds for the pane to die (SessionEnd hooks run that way).
graceful_exit() {
    local id=$1 repo=$2 i
    pane_dead "$id" && return 0
    tmux send-keys -t "$id" Escape
    sleep 0.3
    tmux send-keys -t "$id" '/exit' Enter
    for (( i = 0; i < EXIT_WAIT * 2; i++ )); do
        pane_exists "$id" || return 0
        pane_dead "$id" && return 0
        sleep 0.5
    done
    warn "$repo did not exit within ${EXIT_WAIT}s — killing"
    return 1
}

# Idempotent settings on every standing window and view session: labelled
# borders, dead panes kept, mouse, size that follows the attached terminal.
apply_options() {
    local w s
    for s in $(view_sessions); do
        tmux set-option -t "$s:" default-size "${DEF_W}x${DEF_H}"
        tmux set-option -t "$s:" mouse on
    done
    for w in $(std_windows); do
        tmux set-option -w -t "$(win_t "$w")" window-size latest
        tmux set-option -w -t "$(win_t "$w")" automatic-rename off
        tmux set-option -w -t "$(win_t "$w")" remain-on-exit on
        tmux set-option -w -t "$(win_t "$w")" pane-border-status top
        # The label takes its own pane's accent, so in a grid window each EM's
        # border names its repo in that repo's colour (kalmia#265).
        tmux set-option -w -t "$(win_t "$w")" pane-border-format '#{?@accent,#[fg=#{@accent}],} #{@repo}#{?pane_dead, [dead],} '
        tmux select-layout -t "$(win_t "$w")" tiled >/dev/null
    done
    paint_ems
}

# #rrggbb for a hue in degrees and a saturation and lightness in percent.
hsl_hex() {
    awk -v h="$1" -v s="$2" -v l="$3" '
        function mn(a, b) { return a < b ? a : b }
        function mx(a, b) { return a > b ? a : b }
        function ch(n,   k, a) {
            k = (n + h / 30) % 12
            a = s / 100 * mn(l / 100, 1 - l / 100)
            return int(255 * (l / 100 - a * mx(-1, mn(mn(k - 3, 9 - k), 1))) + 0.5)
        }
        BEGIN { printf "#%02x%02x%02x", ch(0), ch(8), ch(4) }'
}

# Sets TINT (pane background) and ACCENT (border, status line) for a repo. A repo
# not in HUE gets a hue from a CRC of its name, spread over the 299 degrees
# outside the link-blue band (195-255): stable across runs and machines.
repo_colors() {
    local h=${HUE[$1]:-} s_t=$TINT_S s_a=$ACCENT_S
    if [[ -z "$h" ]]; then
        h=$(( $(printf '%s' "$1" | cksum | cut -d' ' -f1) % 299 ))
        (( h < 195 )) || h=$(( h + 61 ))
    elif [[ "$h" == neutral ]]; then
        h=0; s_t=0; s_a=0
    fi
    TINT=$(hsl_hex "$h" "$s_t" "$TINT_L")
    ACCENT=$(hsl_hex "$h" "$s_a" "$ACCENT_L")
}

# Paint every EM (kalmia#265). Each pane gets its repo's tint as its background
# and its accent as @accent, which colours the border label naming the repo.
# Each window's border line takes its (first) EM's accent, and each view session
# that accent as its status line, with the tint as the text.
# The base session keeps tmux's own status line. Idempotent: `up`, `show` and
# `open` re-apply it, so a running EM repaints after a hue changes.
paint_ems() {
    local w s id repo
    local -A w_accent=() w_tint=()
    for w in $(std_windows); do
        while IFS="$US" read -r id repo; do
            [[ -n "$repo" ]] || continue
            repo_colors "$repo"
            tmux set-option -p -t "$id" @accent "$ACCENT"
            tmux set-option -p -t "$id" window-style "bg=$TINT"
            tmux set-option -p -t "$id" window-active-style "bg=$TINT"
            [[ -n "${w_accent[$w]:-}" ]] || { w_accent[$w]=$ACCENT; w_tint[$w]=$TINT; }
        done < <(tmux list-panes -t "$(win_t "$w")" -F "#{pane_id}${US}#{@repo}" 2>/dev/null || true)
        [[ -n "${w_accent[$w]:-}" ]] || continue
        tmux set-option -w -t "$(win_t "$w")" pane-border-style "fg=${w_accent[$w]}"
        tmux set-option -w -t "$(win_t "$w")" pane-active-border-style "fg=${w_accent[$w]},bold"
    done
    for s in $(view_sessions); do
        w=$(view_window "$s")
        [[ -n "$w" && -n "${w_accent[$w]:-}" ]] || continue
        tmux set-option -t "$s:" status-style "bg=${w_accent[$w]},fg=${w_tint[$w]}"
    done
}

# The Director's frame: a gold border line naming it and a gold status line, on
# the terminal's own background. Idempotent, like paint_ems.
paint_director() {
    tmux set-option -w -t "=$DIRECTOR_NAME:" pane-border-status top
    tmux set-option -w -t "=$DIRECTOR_NAME:" pane-border-format " $DIRECTOR_TITLE#{?pane_dead, [dead],} "
    tmux set-option -w -t "=$DIRECTOR_NAME:" pane-border-style "fg=$DIRECTOR_ACCENT"
    tmux set-option -w -t "=$DIRECTOR_NAME:" pane-active-border-style "fg=$DIRECTOR_ACCENT,bold"
    tmux set-option -t "=$DIRECTOR_NAME:" status-style "bg=$DIRECTOR_ACCENT,fg=$EMBER"
}

# A window's tint, for the terminal's padding: its active pane's repo.
win_tint() {
    local repo
    repo=$(tmux display-message -p -t "$(win_t "$1")" '#{@repo}' 2>/dev/null || true)
    [[ -n "$repo" ]] || return 0
    repo_colors "$repo"
    printf '%s' "$TINT"
}

have_display() { [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; }

pick_terminal() {
    local t
    TERM_BIN="${STANDING_TERMINAL:-}"
    [[ -n "$TERM_BIN" ]] && return 0
    for t in ghostty ptyxis alacritty; do
        command -v "$t" >/dev/null 2>&1 && { TERM_BIN=$t; return 0; }
    done
    die "no terminal emulator found (ghostty, ptyxis, alacritty) — set STANDING_TERMINAL"
}

# A terminal's title: "<repo> — standing EM" for a window holding one EM (its
# own window, or a one-pane grid window from before #248), the window name for
# a grid window holding several.
term_title() {
    local repo
    if (( $(win_panes "$1") > 1 )); then printf '%s' "$1"; return 0; fi
    repo=$(tmux display-message -p -t "$(win_t "$1")" '#{@repo}' 2>/dev/null || true)
    printf '%s — standing EM' "${repo:-$1}"
}

# Open a maximized terminal attached to a view session, with the given title,
# at the terminal's own font size unless STANDING_FONT_SIZE says otherwise. An
# optional third argument, the EM's tint, also colours ghostty's own background,
# so its padding matches the tinted pane instead of framing it in ember.
launch_terminal() {
    local view=$1 title=$2 bg=${3:-} fs="${STANDING_FONT_SIZE:-}"
    local -a attach=(tmux attach-session -t "=$view") cmd
    case "$TERM_BIN" in
        ghostty)   cmd=(ghostty --maximize=true --title="$title" ${fs:+--font-size="$fs"} ${bg:+--background="$bg"} -e "${attach[@]}") ;;
        ptyxis)    cmd=(ptyxis --new-window --maximize --title "$title" -- "${attach[@]}") ;;
        alacritty) cmd=(alacritty --title "$title" -o window.startup_mode=Maximized ${fs:+-o font.size="$fs"} -e "${attach[@]}") ;;
        *)         cmd=("$TERM_BIN" -e "${attach[@]}") ;;
    esac
    setsid -f "${cmd[@]}" >/dev/null 2>&1
}

# Remove view sessions whose window no longer exists (closes their terminals) —
# left behind when a pane was closed by hand, say, and now showing another EM.
prune_views() {
    local s w
    local -a wins=()
    mapfile -t wins < <(tmux list-windows -t "=$TMUX_SESSION" -F '#{window_name}' 2>/dev/null || true)
    for s in $(view_sessions); do
        w=$(view_window "$s")
        [[ -n "$w" ]] || continue
        printf '%s\n' "${wins[@]}" | grep -qxF -- "$w" || tmux kill-session -t "=$s" 2>/dev/null || true
    done
}

# Close the terminal showing a window that is about to go: kill its view session.
close_view() {
    tmux kill-session -t "=$(view_for "$1")" 2>/dev/null || true
}

# Pad a coloured string to N visible columns; printf's widths count bytes, codes included.
vpad() {
    local plain=$1 c
    for c in "$c_ok" "$c_warn" "$c_err" "$c_dim" "$c_off"; do plain=${plain//"$c"/}; done
    printf '%s%*s' "$1" $(( $2 > ${#plain} ? $2 - ${#plain} : 0 )) ''
}

# A pane's state for `status`: dead, trust? (at the folder-trust dialog), running,
# or whatever else it runs. Args: pane id, pane_dead, pane_current_command.
pane_state() {
    if [[ "$2" == 1 ]]; then
        printf '%s' "${c_err}dead${c_off}"
    elif [[ "$3" == claude* || "$3" == node* ]] && at_trust_prompt "$1"; then
        printf '%s' "${c_warn}trust?${c_off}"
    elif [[ "$3" == claude* || "$3" == node* ]]; then
        printf '%s' "${c_ok}running${c_off}"
    else
        printf '%s' "${c_warn}$3${c_off}"
    fi
}

# ------------------------------------------------ sessions outside tmux ----
# Claude Code keeps a record for every live session in ~/.claude/sessions/<pid>.json:
# name, entrypoint, cwd, status, procStart, pidDomain. A record counts only when its
# pidDomain is this host's (machine id and pid namespace), its pid is alive and its
# procStart matches that process, so records copied in from another machine or left
# by a reused pid are ignored. python3 parses them: Ansible needs it on every target.

SESSIONS_DIR="${STANDING_SESSIONS_DIR:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/sessions}"

# One line per live session record: pid US name US entrypoint US status US cwd.
live_sessions() {
    [[ -d "$SESSIONS_DIR" ]] && command -v python3 >/dev/null 2>&1 || return 0
    python3 - "$SESSIONS_DIR" 2>/dev/null <<'PY' || true
import glob, json, os, sys
try:
    domain = "linux:%s:%s" % (open("/etc/machine-id").read().strip(), os.readlink("/proc/self/ns/pid"))
except OSError:
    domain = None
for path in sorted(glob.glob(os.path.join(sys.argv[1], "*.json"))):
    try:
        with open(path) as f:
            r = json.load(f)
        pid = int(r["pid"])
        with open("/proc/%d/stat" % pid) as f:
            start = f.read().rsplit(")", 1)[1].split()[19]
    except (OSError, ValueError, KeyError, IndexError, TypeError, AttributeError):
        continue
    if domain and r.get("pidDomain") not in (None, domain):
        continue
    if str(r.get("procStart", start)) != start:
        continue
    out = [str(pid)] + [str(r.get(k) or "") for k in ("name", "entrypoint", "status", "cwd")]
    print("\x1f".join(v.replace("\x1f", " ").replace("\n", " ") for v in out))
PY
}

# Pane pids of the sessions standing manages: the EMs' and the Director's.
managed_pane_pids() {
    command -v tmux >/dev/null 2>&1 || return 0
    if has_session; then tmux list-panes -s -t "=$TMUX_SESSION" -F '#{pane_pid}' 2>/dev/null || true; fi
    if director_up; then tmux list-panes -s -t "=$DIRECTOR_NAME" -F '#{pane_pid}' 2>/dev/null || true; fi
}

# live_sessions() minus those running in a managed pane (the pid, or an ancestor
# of it, is a pane's pid). Same line format.
outside_sessions() {
    local -A pane=()
    local p line
    for p in $(managed_pane_pids); do pane[$p]=1; done
    while IFS= read -r line; do
        p=${line%%"$US"*}
        while [[ -n "$p" && "$p" != 0 && "$p" != 1 && -z "${pane[$p]:-}" ]]; do
            p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ') || p=""
        done
        if [[ -n "$p" && -n "${pane[$p]:-}" ]]; then continue; fi
        printf '%s\n' "$line"
    done < <(live_sessions)
}

# Pid of the live session named $1 outside the managed panes, if there is one.
outside_pid_of() { outside_sessions | awk -F"$US" -v n="$1" '$2 == n { print $1; exit }'; }

# Warn before starting a session whose name is already live outside tmux:
# two sessions under one name split it, and messages reach either.
warn_if_outside() {
    local op
    op=$(outside_pid_of "$1")
    [[ -z "$op" ]] || warn "a session named '$1' already runs outside tmux (pid $op): this starts a second one under the same name — close that one first"
}

# Where a session runs, from its record's entrypoint.
where_of() {
    case "$1" in
        cli | "")       printf 'cli' ;;
        claude-vscode)  printf 'vscode' ;;
        claude-desktop) printf 'desktop' ;;
        sdk*)           printf 'sdk' ;;
        *)              printf '%s' "${1#claude-}" ;;
    esac
}

# A session's role from its name ($1) and cwd ($2).
role_of() {
    if [[ "$1" == "$DIRECTOR_NAME" ]]; then printf 'director'
    elif [[ "$1" == *-"$NAME_SUFFIX" ]]; then printf 'em'
    elif [[ "$2" == "$REPOS_DIR" || "$2" == "$REPOS_DIR"/* ]]; then printf 'ad-hoc'
    else printf 'other'; fi
}

# --------------------------------------------------------------- director ----
# The Director's own tmux session: not grouped with the EMs' base session, so
# view_sessions(), `down` and `open` never see it. Its terminal attaches to the
# session itself; there is no view.

director_up()   { tmux has-session -t "=$DIRECTOR_NAME" 2>/dev/null; }
director_pane() { { tmux list-panes -s -t "=$DIRECTOR_NAME" -F '#{pane_id}' 2>/dev/null || true; } | head -n1; }

# claude for the Director: CLAUDE* stripped, its standing name, resuming the
# latest conversation in REPOS_DIR unless FRESH, then the caller's extras.
director_argv() {
    local -a cmd=()
    mapfile -d '' cmd < <(env_prefix)
    cmd+=("$CLI_BIN" --name "$DIRECTOR_NAME")
    mapfile -d '' -O "${#cmd[@]}" cmd < <(remote_control_args "$DIRECTOR_NAME")
    (( FRESH )) || cmd+=(--continue)
    cmd+=("${EXTRA[@]}")
    printf '%s\0' "${cmd[@]}"
}

# Create the Director's session, or respawn its pane if claude has exited;
# a live one is left alone. Sets D_STATE to started, respawned or running.
ensure_director() {
    local id
    local -a cmd=()
    mapfile -d '' cmd < <(director_argv)
    (( ${#cmd[@]} >= 3 )) || die "internal: could not build the claude command for the Director"
    if ! director_up; then
        warn_if_outside "$DIRECTOR_NAME"
        # remain-on-exit in the same command sequence, so a claude that exits at
        # once (nothing to --continue, say) leaves its screen instead of the session vanishing.
        tmux new-session -d -s "$DIRECTOR_NAME" -n "$DIRECTOR_WIN" -x "$DEF_W" -y "$DEF_H" \
            -c "$REPOS_DIR" -- "${cmd[@]}" \; set-option -w -t "=$DIRECTOR_NAME:" remain-on-exit on
        D_STATE=started
    else
        id=$(director_pane)
        if [[ -n "$id" ]] && pane_dead "$id"; then
            tmux respawn-pane -k -t "$id" -c "$REPOS_DIR" -- "${cmd[@]}"
            D_STATE=respawned
        else
            D_STATE=running
        fi
    fi
    tmux set-option -t "=$DIRECTOR_NAME:" default-size "${DEF_W}x${DEF_H}"
    tmux set-option -t "=$DIRECTOR_NAME:" mouse on
    tmux set-option -w -t "=$DIRECTOR_NAME:" window-size latest
    tmux set-option -w -t "=$DIRECTOR_NAME:" automatic-rename off
    tmux set-option -w -t "=$DIRECTOR_NAME:" remain-on-exit on
    paint_director
}

# Open a maximized terminal on the Director unless one already shows it.
show_director() {
    director_up || die "the Director is not running — 'director' starts it ('director --open' in its own window)"
    paint_director   # repaint even when it is already shown (kalmia#265)
    local n
    n=$(clients_of "$DIRECTOR_NAME")
    if (( n )); then
        say "the Director is already shown in $n terminal(s)"
        return 0
    fi
    have_display || die "no display — run 'director' in a terminal instead"
    pick_terminal
    scrub_env
    launch_terminal "$DIRECTOR_NAME" "$DIRECTOR_TITLE"
    ok "opened $TERM_BIN for the Director"
}

# Detach every terminal from the Director's session; its claude keeps running.
hide_director() {
    director_up || die "the Director is not running"
    local n
    n=$(clients_of "$DIRECTOR_NAME")
    if (( n == 0 )); then
        say "the Director has no terminal open; its session keeps running"
        return 0
    fi
    tmux detach-client -s "=$DIRECTOR_NAME"
    ok "closed $n terminal(s) for the Director; its session keeps running"
}

# /exit the Director's claude, then end its session (and so its terminals).
down_director() {
    director_up || { say "the Director is not running"; return 0; }
    local id
    id=$(director_pane)
    if [[ -n "$id" ]]; then graceful_exit "$id" "the Director" || true; fi
    tmux kill-session -t "=$DIRECTOR_NAME" 2>/dev/null || true
    ok "the Director is down (tmux session '$DIRECTOR_NAME' closed)"
}

# Attach this terminal to the Director (switch-client inside tmux).
attach_director() {
    if [[ -n "${TMUX:-}" ]]; then
        tmux switch-client -t "=$DIRECTOR_NAME"
    elif [[ -t 0 && -t 1 ]]; then
        exec tmux attach-session -t "=$DIRECTOR_NAME"
    else
        say "Not attaching: this is not a terminal. 'director' from a terminal attaches; 'director --open' opens one."
    fi
}

# ------------------------------------------------------------- commands ----

cmd_director() {
    need tmux; need claude
    CLI_BIN=$(command -v claude)
    local open=0
    FRESH=0; EXTRA=()
    while (( $# )); do
        case "$1" in
            --open)         open=1; shift ;;
            --fresh)        FRESH=1; shift ;;
            -h|--help)      usage; return 0 ;;
            --)             shift; EXTRA=("$@"); break ;;
            *)              die "unknown option for director: $1 (try --help)" ;;
        esac
    done
    [[ -d "$REPOS_DIR" ]] || die "$REPOS_DIR does not exist"
    scrub_env
    ensure_director
    case "$D_STATE" in
        started)   ok "the Director started  ${c_dim}(claude --name $DIRECTOR_NAME$( (( FRESH )) || printf ' --continue') in $REPOS_DIR)${c_off}" ;;
        respawned) ok "the Director respawned  ${c_dim}(its claude had exited)${c_off}" ;;
        running)   say "${c_dim}  · the Director is already running${c_off}"
                   (( FRESH == 0 && ${#EXTRA[@]} == 0 )) || warn "--fresh and claude args apply only when claude starts; /exit it first" ;;
    esac
    if (( open )); then show_director; else attach_director; fi
}

cmd_up() {
    need tmux; need claude
    [[ "$PER_WINDOW" =~ ^[1-9][0-9]*$ ]] || die "STANDING_PER_WINDOW must be a positive integer, not '$PER_WINDOW'"
    CLI_BIN=$(command -v claude)
    parse_launch_flags "$@"
    resolve_repos "${SEL[@]}"
    scrub_env

    local repo dir id w where started=0 respawned=0 kept=0
    local -a want=()   # windows of the EMs this run starts or respawns: the only ones it opens
    for repo in "${REPOS[@]}"; do
        dir="$REPOS_DIR/$repo"
        local -a cmd=()
        mapfile -d '' cmd < <(claude_argv "$repo")
        (( ${#cmd[@]} >= 3 )) || die "internal: could not build the claude command for $repo"

        id=$(pane_for "$repo")
        if [[ -n "$id" ]]; then
            if pane_dead "$id"; then
                tmux respawn-pane -k -t "$id" -c "$dir" -- "${cmd[@]}"
                want+=("$(window_of "$id")")
                ok "$repo respawned"
                respawned=$((respawned + 1))
            else
                say "${c_dim}  · $repo already running${c_off}"
                kept=$((kept + 1))
            fi
        else
            warn_if_outside "$repo-$NAME_SUFFIX"
            id=$(spawn_pane "$repo" "$dir" "${cmd[@]}")
            w=$(window_of "$id"); want+=("$w")
            if [[ "$w" == "$(win_name "$repo")" ]]; then where="its own window"; else where="window $w"; fi
            ok "$repo started in $where  ${c_dim}(claude --name $repo-$NAME_SUFFIX$(m=$(effective_model); [[ -n "$m" ]] && printf ' --model %s' "$m"))${c_off}"
            started=$((started + 1))
        fi
        apply_options
    done
    if (( NO_DIRECTOR )); then forget_director; elif [[ -n "$DIRECTOR" ]]; then remember_director "$DIRECTOR"; fi
    say ""
    say "Up: $started started, $respawned respawned, $kept already running, $(std_windows | wc -l) window(s)${DIRECTOR:+, Director $DIRECTOR}"
    # Terminals only for what this run started: a window whose terminal someone
    # closed on purpose stays closed until an explicit `standing open`.
    local -A asked=()
    if (( OPEN )) && have_display && (( ${#want[@]} )); then
        open_terminals "${want[@]}"
        for w in "${want[@]}"; do asked[$w]=1; done
    fi
    local lacking=0
    for w in $(std_windows); do
        [[ -n "${asked[$w]:-}" ]] && continue
        if (( $(clients_of "$(view_for "$w")") == 0 )); then lacking=$((lacking + 1)); fi
    done
    if (( lacking )); then
        say "$lacking window(s) without a terminal, left as they are: 'standing open' opens them, 'standing attach' looks in"
    fi
}

cmd_restart() {
    need tmux; need claude
    CLI_BIN=$(command -v claude)
    parse_launch_flags "$@"
    has_session || die "tmux session '$TMUX_SESSION' is not running — 'standing up' first"
    local -a targets=()
    if (( ${#SEL[@]} )); then
        targets=("${SEL[@]}")
    else
        mapfile -t targets < <(all_panes | awk -F"$US" '$3 != "" { print $3 }')
    fi
    scrub_env
    local repo id n=0
    for repo in "${targets[@]}"; do
        id=$(pane_for "$repo")
        [[ -n "$id" ]] || { warn "$repo: no such pane"; continue; }
        local -a cmd=()
        mapfile -d '' cmd < <(claude_argv "$repo")
        (( ${#cmd[@]} >= 3 )) || die "internal: could not build the claude command for $repo"
        graceful_exit "$id" "$repo" || true
        tmux respawn-pane -k -t "$id" -c "$REPOS_DIR/$repo" -- "${cmd[@]}"
        ok "$repo restarted  ${c_dim}($(m=$(effective_model); [[ -n "$m" ]] && printf -- '--model %s' "$m"))${c_off}"
        n=$((n + 1))
    done
    apply_options
    if (( NO_DIRECTOR )); then forget_director; elif [[ -n "$DIRECTOR" ]]; then remember_director "$DIRECTOR"; fi
    say ""
    say "Restarted $n pane(s) in place as fresh sessions${DIRECTOR:+, Director $DIRECTOR}"
}

# The Director's row first, then one row per EM in window order. TERM is how
# many terminals show the session ("none" — 'standing open' fixes it for an EM,
# 'standing show director' for the Director); WINDOW appears only while some EM
# sits in a window not named after it (a grid window standing-N).
cmd_status() {
    need tmux
    local w n term id repo dead pid cmdname size i show_win=0 lacking=0 ems=1
    local d_state d_term="-" d_pid="-" d_size="-" d_out="" line o_pid o_name o_entry o_state o_cwd
    local -a out=() dup=()
    local -A in_tmux=()
    local -a r_repo=() r_state=() r_term=() r_win=() r_pid=() r_size=()
    if director_up; then
        n=$(clients_of "$DIRECTOR_NAME")
        if (( n == 0 )); then d_term=none; else d_term=$n; fi
        id=""
        IFS="$US" read -r id dead d_pid cmdname d_size < <({ tmux list-panes -s -t "=$DIRECTOR_NAME" \
            -F "#{pane_id}${US}#{pane_dead}${US}#{pane_pid}${US}#{pane_current_command}${US}#{pane_width}x#{pane_height}" \
            2>/dev/null || true; } | head -n1) || true
        if [[ -n "$id" ]]; then d_state=$(pane_state "$id" "$dead" "$cmdname"); else d_state="${c_warn}gone${c_off}"; fi
    else
        d_state="${c_dim}down${c_off}"
    fi
    if ! has_session || [[ -z "$(std_windows)" ]]; then ems=0; fi
    if (( ems )); then
        for w in $(std_windows); do
            n=$(clients_of "$(view_for "$w")")
            if (( n == 0 )); then term=none; lacking=$((lacking + 1)); else term=$n; fi
            while IFS="$US" read -r id repo dead pid cmdname size; do
                [[ -n "$repo" ]] || repo="(untagged $id)"
                [[ "$w" == "$(win_name "$repo")" ]] || show_win=1
                r_repo+=("$repo"); r_state+=("$(pane_state "$id" "$dead" "$cmdname")"); r_term+=("$term")
                r_win+=("$w"); r_pid+=("$pid"); r_size+=("$size")
            done < <(tmux list-panes -t "$(win_t "$w")" -F "#{pane_id}${US}#{@repo}${US}#{pane_dead}${US}#{pane_pid}${US}#{pane_current_command}${US}#{pane_width}x#{pane_height}")
        done
    fi
    # The state is pre-padded by visible width (vpad): printf would count its colour codes.
    if (( show_win )); then
        printf '%-30s %-9s %-5s %-12s %-8s %-9s %s\n' REPO STATE TERM WINDOW PID SIZE SESSION
        printf '%-30s %s %-5s %-12s %-8s %-9s %s\n' "(director)" "$(vpad "$d_state" 9)" "$d_term" "-" "$d_pid" "$d_size" "$DIRECTOR_NAME"
    else
        printf '%-30s %-9s %-5s %-8s %-9s %s\n' REPO STATE TERM PID SIZE SESSION
        printf '%-30s %s %-5s %-8s %-9s %s\n' "(director)" "$(vpad "$d_state" 9)" "$d_term" "$d_pid" "$d_size" "$DIRECTOR_NAME"
    fi
    for i in "${!r_repo[@]}"; do
        if (( show_win )); then
            printf '%-30s %s %-5s %-12s %-8s %-9s %s\n' "${r_repo[$i]}" "$(vpad "${r_state[$i]}" 9)" "${r_term[$i]}" \
                "${r_win[$i]}" "${r_pid[$i]}" "${r_size[$i]}" "${r_repo[$i]}-$NAME_SUFFIX"
        else
            printf '%-30s %s %-5s %-8s %-9s %s\n' "${r_repo[$i]}" "$(vpad "${r_state[$i]}" 9)" "${r_term[$i]}" \
                "${r_pid[$i]}" "${r_size[$i]}" "${r_repo[$i]}-$NAME_SUFFIX"
        fi
    done
    for i in "${!r_repo[@]}"; do in_tmux["${r_repo[$i]}-$NAME_SUFFIX"]=1; done
    director_up && in_tmux["$DIRECTOR_NAME"]=1
    mapfile -t out < <(outside_sessions)
    if (( ${#out[@]} )); then
        say ""
        say "Outside standing's tmux (Claude Code session records):"
        printf '%-30s %-9s %-8s %-8s %s\n' SESSION STATE WHERE PID ROLE
        for line in "${out[@]}"; do
            IFS="$US" read -r o_pid o_name o_entry o_state o_cwd <<<"$line"
            printf '%-30s %-9s %-8s %-8s %s\n' "${o_name:-(unnamed)}" "${o_state:--}" "$(where_of "$o_entry")" \
                "$o_pid" "$(role_of "$o_name" "$o_cwd")"
            [[ "$o_name" == "$DIRECTOR_NAME" && -z "$d_out" ]] && d_out="$(where_of "$o_entry"), pid $o_pid"
            [[ -n "$o_name" && -n "${in_tmux[$o_name]:-}" ]] && dup+=("$o_name")
        done
        say ""
    fi
    if (( ! ems )); then
        say "No EMs in tmux: session '$TMUX_SESSION' is not running — 'standing up <repo>' starts one"
    fi
    if ! director_up && [[ -n "$d_out" ]]; then
        say "${c_warn}The Director runs outside tmux ($d_out): 'director' would start a second '$DIRECTOR_NAME' — close that one first${c_off}"
    elif ! director_up; then
        say "${c_dim}The Director is not in tmux — 'director' starts or resumes it${c_off}"
    elif [[ "$d_state" == *trust\?* ]]; then
        say "${c_warn}The Director waits at the folder-trust dialog — 'director' attaches you to answer it${c_off}"
    fi
    if (( lacking )); then
        say "${c_warn}$lacking window(s) without a terminal — 'standing open' opens them${c_off}"
    fi
    for line in "${dup[@]}"; do
        say "${c_warn}Two sessions are named '$line', one in tmux and one outside: messages reach either — close one${c_off}"
    done
}

cmd_down() {
    need tmux
    local -a targets=()
    local a whole=0 dir=0
    # "director" is the Director's session, never an EM; only naming it ends it.
    for a in "$@"; do
        if [[ "$a" == director ]]; then dir=1; else targets+=("$a"); fi
    done
    if (( dir )); then
        down_director
        (( ${#targets[@]} )) || return 0
    fi
    has_session || { say "tmux session '$TMUX_SESSION' is not running"; return 0; }
    if (( ${#targets[@]} == 0 )); then
        whole=1
        mapfile -t targets < <(all_panes | awk -F"$US" '$3 != "" { print $3 }')
    fi
    local repo id w
    for repo in "${targets[@]}"; do
        id=$(pane_for "$repo")
        [[ -n "$id" ]] || { warn "$repo: no such pane"; continue; }
        w=$(window_of "$id")
        graceful_exit "$id" "$repo" || true
        # The window goes with its last pane: close its terminal first, so it
        # never flashes another EM's window on the way out.
        if (( $(win_panes "$w") <= 1 )); then close_view "$w"; fi
        pane_exists "$id" && tmux kill-pane -t "$id"
        ok "$repo down"
        if (( ! whole )) && tmux list-windows -t "=$TMUX_SESSION" -F '#{window_name}' 2>/dev/null | grep -qxF "$w"; then
            tmux select-layout -t "$(win_t "$w")" tiled >/dev/null
        fi
    done
    if (( whole )); then
        local s
        for s in $(view_sessions); do
            [[ "$s" == "$TMUX_SESSION" ]] || tmux kill-session -t "=$s" 2>/dev/null || true
        done
        has_session && tmux kill-session -t "=$TMUX_SESSION"
        ok "tmux session '$TMUX_SESSION' closed"
        if director_up; then say "${c_dim}  · the Director keeps running ('standing down director' ends it)${c_off}"; fi
    else
        prune_views
    fi
}

cmd_open() { open_terminals; }

# Open a maximized terminal for each named window that has none: every standing
# window when none are named (`standing open`); `up` names only the windows of
# the EMs it just started or respawned.
open_terminals() {
    need tmux
    has_session || die "tmux session '$TMUX_SESSION' is not running — 'standing up' first"
    local w view all=0
    local -a wins=("$@") missing=()
    local -A seen=()
    prune_views
    if (( ${#wins[@]} == 0 )); then all=1; mapfile -t wins < <(std_windows); fi
    # Views first (cheap, no display needed), then decide whether a terminal is even wanted.
    for w in "${wins[@]}"; do
        [[ -z "${seen[$w]:-}" ]] || continue   # two EMs started into one grid window
        seen[$w]=1
        view=$(view_for "$w")
        if ! tmux has-session -t "=$view" 2>/dev/null; then
            # A grouped session: same windows as the base, its own current window.
            tmux new-session -d -t "$TMUX_SESSION" -s "$view"
        fi
        tmux select-window -t "=$view:=$w"
        if (( $(clients_of "$view") == 0 )); then missing+=("$w"); fi
    done
    apply_options
    if (( ${#missing[@]} == 0 )); then
        if (( all )); then say "Every window already has a terminal"; else say "Already in a terminal: ${!seen[*]}"; fi
        return 0
    fi
    have_display || die "no display — use 'standing attach' from a terminal instead"
    pick_terminal
    scrub_env
    for w in "${missing[@]}"; do
        launch_terminal "$(view_for "$w")" "$(term_title "$w")" "$(win_tint "$w")"
        ok "opened $TERM_BIN for $w"
    done
    # Re-tile grid windows once the new clients' sizes have been picked up
    # (a window of one pane has nothing to tile).
    if [[ -n "$(grid_windows)" ]]; then
        ( sleep 2; for w in $(grid_windows); do tmux select-layout -t "$(win_t "$w")" tiled >/dev/null 2>&1; done ) &
    fi
}

# One EM's terminal: open it unless a terminal already shows that EM's window.
cmd_show() {
    need tmux
    if (( $# != 1 )) || [[ "$1" == -* ]]; then die "usage: standing show <repo>|director"; fi
    if [[ "$1" == director ]]; then show_director; return; fi
    local repo=$1 id w n
    id=$(pane_for "$repo")
    [[ -n "$id" ]] || die "$repo has no standing EM — 'standing up $repo' starts one, terminal included"
    w=$(window_of "$id")
    paint_ems   # repaint even when it is already shown, so a hue change lands (kalmia#265)
    n=$(clients_of "$(view_for "$w")")
    if (( n )); then
        say "$repo is already shown in $n terminal(s)"
        return 0
    fi
    tmux select-pane -t "$id"   # in a grid window, focus this EM's pane
    open_terminals "$w"
}

# Close one EM's terminal(s) by detaching every client of its view session; the
# pane and its claude keep running, and `standing show <repo>` brings one back.
cmd_hide() {
    need tmux
    if (( $# != 1 )) || [[ "$1" == -* ]]; then die "usage: standing hide <repo>|director"; fi
    if [[ "$1" == director ]]; then hide_director; return; fi
    local repo=$1 id view n
    id=$(pane_for "$repo")
    [[ -n "$id" ]] || die "$repo has no standing EM ('standing status' lists them)"
    view=$(view_for "$(window_of "$id")")
    n=$(clients_of "$view")
    if (( n == 0 )); then
        say "$repo has no terminal open; its session keeps running"
        return 0
    fi
    tmux detach-client -s "=$view"
    ok "closed $n terminal(s) for $repo; its session keeps running"
}

cmd_attach() {
    need tmux
    if [[ "${1:-}" == director ]]; then
        director_up || die "the Director is not running — 'director' starts it"
        attach_director
        return
    fi
    has_session || die "tmux session '$TMUX_SESSION' is not running — 'standing up' first"
    if (( $# )); then
        local id w; id=$(pane_for "$1")
        [[ -n "$id" ]] || die "$1: no such pane"
        w=$(window_of "$id")
        tmux select-window -t "$(win_t "$w")"
        tmux select-pane -t "$id"
    fi
    if [[ -n "${TMUX:-}" ]]; then
        tmux switch-client -t "=$TMUX_SESSION"
    else
        exec tmux attach-session -t "=$TMUX_SESSION"
    fi
}

cmd_trust() {
    need tmux
    [[ -n "$(std_windows)" ]] || die "no standing windows in session '$TMUX_SESSION'"
    local yes=0 a w id repo lbl i n=0
    local -a only=() w_ids=() w_repos=() w_wins=()
    for a in "$@"; do
        case "$a" in
            --yes|-y) yes=1 ;;
            -*)       die "unknown option: $a" ;;
            *)        only+=("$a") ;;
        esac
    done
    while IFS="$US" read -r w id repo; do
        if (( ${#only[@]} )); then
            local hit=0; for a in "${only[@]}"; do [[ "$a" == "$repo" ]] && hit=1; done
            (( hit )) || continue
        fi
        at_trust_prompt "$id" || continue
        w_ids+=("$id"); w_repos+=("$repo"); w_wins+=("$w")
    done < <(all_panes)
    if (( ${#w_ids[@]} == 0 )); then
        say "No pane is waiting at the folder-trust dialog"
        return 0
    fi
    say "Waiting at the folder-trust dialog:"
    for i in "${!w_ids[@]}"; do
        w=${w_wins[$i]}
        if [[ "$w" == "$(win_name "${w_repos[$i]}")" ]]; then w=""; else w="  ${c_dim}($w)${c_off}"; fi
        say "  ${w_repos[$i]}$w"
    done
    if (( ! yes )); then
        [[ -t 0 ]] || die "not a terminal — pass --yes to accept without the prompt"
        read -r -p "Accept folder trust in these ${#w_ids[@]} pane(s)? [y/N] " a
        [[ "$a" =~ ^[Yy] ]] || { say "Nothing accepted"; return 0; }
    fi
    for i in "${!w_ids[@]}"; do
        id=${w_ids[$i]}; repo=${w_repos[$i]}; w=${w_wins[$i]}
        lbl=$repo; [[ "$w" == "$(win_name "$repo")" ]] || lbl+=" ($w)"
        at_trust_prompt "$id" || { warn "$lbl: dialog gone, skipped"; continue; }
        # Move the cursor onto "Yes" unless it is already there, let the dialog
        # redraw, and only confirm once the cursor is verifiably on Yes — a Down
        # that arrives before the dialog reads keys echoes as text instead.
        trust_cursor_on_yes "$id" || { tmux send-keys -t "$id" Down; sleep 0.6; }
        if trust_cursor_on_yes "$id"; then
            tmux send-keys -t "$id" Enter
            # Give the dialog up to 5 s to go away before calling it a failure.
            for (( a = 0; a < 10; a++ )); do
                sleep 0.5
                pane_dead "$id" && break
                at_trust_prompt "$id" || break
            done
            if pane_dead "$id"; then
                warn "$lbl: claude exited instead of accepting — 'standing up' respawns it"
            elif at_trust_prompt "$id"; then
                warn "$lbl: the dialog is still showing — click the pane and accept by hand"
            else
                ok "$lbl: accepted folder trust"
                n=$((n + 1))
            fi
        else
            warn "$lbl: cursor is not on Yes — click the pane and accept by hand"
        fi
    done
    say "Accepted in $n pane(s)"
}

cmd_tile() {
    need tmux
    [[ -n "$(std_windows)" ]] || die "no standing windows in session '$TMUX_SESSION'"
    apply_options
    ok "tiled $(all_panes | wc -l) panes across $(std_windows | wc -l) window(s)"
}

cmd_repos() {
    resolve_repos "$@"
    printf '%s\n' "${REPOS[@]}"
}

usage() { sed -n '2,/^set -euo/{/^set -euo/d;s/^# \{0,1\}//;p}' "$0"; }

main() {
    local sub=${1:-status}
    (( $# )) && shift
    case "$sub" in
        up)             cmd_up "$@" ;;
        director)       cmd_director "$@" ;;
        restart)        cmd_restart "$@" ;;
        down|stop)      cmd_down "$@" ;;
        status|ls)      cmd_status "$@" ;;
        open)           cmd_open "$@" ;;
        show)           cmd_show "$@" ;;
        hide)           cmd_hide "$@" ;;
        attach|a)       cmd_attach "$@" ;;
        tile)           cmd_tile "$@" ;;
        trust)          cmd_trust "$@" ;;
        repos)          cmd_repos "$@" ;;
        -h|--help|help) usage ;;
        *)              die "unknown command: $sub (try --help)" ;;
    esac
}

main "$@"
{% endraw %}
