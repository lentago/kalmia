[Unit]
Description=brasenia focus producer: session beacons to open-PR panes on the viewport bus
After=network-online.target
Wants=network-online.target
RequiresMountsFor={{ pub_viewport_webroot }}
ConditionPathIsMountPoint={{ pub_viewport_webroot }}

[Service]
Type=simple
User={{ pub_viewport_user }}
Group={{ pub_viewport_group }}
Environment=PYTHONDONTWRITEBYTECODE=1
# The GitHub token (brasenia ADR-0021) reaches brasenia-prs and brasenia-focus
# alone, as $CREDENTIALS_DIRECTORY/github-token. The role creates the file
# empty, so the unit starts before the first seed and reads anonymously.
LoadCredential=github-token:{{ pub_viewport_github_token_file }}
WorkingDirectory={{ pub_brasenia_checkout }}/producers/focus
ExecStart=/usr/bin/python3 -m focus_producer --webroot {{ pub_viewport_webroot }} --url-base {{ pub_viewport_url_base }} --interval {{ pub_viewport_focus_interval }}
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
