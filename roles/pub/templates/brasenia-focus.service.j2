[Unit]
Description=brasenia focus producer: session beacons to open-PR panes on the viewport bus
After=network-online.target
Wants=network-online.target
ConditionPathIsMountPoint={{ pub_viewport_webroot }}

[Service]
Type=simple
WorkingDirectory={{ pub_cast_checkout }}/producers/focus
ExecStart=/usr/bin/python3 -m focus_producer --webroot {{ pub_viewport_webroot }} --url-base {{ pub_viewport_url_base }} --interval {{ pub_viewport_focus_interval }}
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
