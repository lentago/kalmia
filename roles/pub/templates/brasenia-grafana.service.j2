[Unit]
Description=brasenia grafana producer: Grafana Cloud dashboards rendered as panes on the viewport bus
After=network-online.target
Wants=network-online.target
RequiresMountsFor={{ pub_viewport_webroot }}
ConditionPathIsMountPoint={{ pub_viewport_webroot }}
# Skipped, not failed, until the token is seeded by hand (docs/pub.md); start
# the unit once it is.
ConditionPathExists={{ pub_viewport_grafana_token_file }}

[Service]
Type=simple
User={{ pub_viewport_user }}
Group={{ pub_viewport_group }}
Environment=PYTHONDONTWRITEBYTECODE=1
# The token reaches this unit alone, as $CREDENTIALS_DIRECTORY/grafana-token.
LoadCredential=grafana-token:{{ pub_viewport_grafana_token_file }}
WorkingDirectory={{ pub_brasenia_checkout }}/producers/grafana
ExecStart=/usr/bin/python3 -m grafana_producer --webroot {{ pub_viewport_webroot }} --grafana-url {{ pub_viewport_grafana_url }} --slots {{ pub_viewport_grafana_slots_file }}
Restart=always
RestartSec=10
# Exit 2 is a refused slot file or stack URL, which a restart cannot fix: the
# unit fails and stays down instead of restarting every 10 s.
RestartPreventExitStatus=2

[Install]
WantedBy=multi-user.target
