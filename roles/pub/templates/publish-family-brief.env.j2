# publish-family-brief environment — rendered by ansible (roles/pub), do not
# hand-edit; change roles/pub/defaults/main.yml and re-run pub.yml.
#
# FAMILY_BRIEF_SRC must name the exact Drive folder the Family Brief routine
# writes latest.json into (its STEP 5b); the two are changed together.
FAMILY_BRIEF_SRC={{ pub_family_brief_src }}
FAMILY_BRIEF_DEST={{ pub_family_brief_dest }}
#
# The Google Doc (#186): its rclone path (empty turns it off), the brasenia
# checkout holding the renderer, and the unprivileged user that runs it.
FAMILY_BRIEF_DOC_DEST={{ pub_family_brief_doc_dest }}
BRASENIA_CHECKOUT={{ pub_brasenia_checkout }}
FAMILY_BRIEF_DOC_USER={{ pub_viewport_user }}
