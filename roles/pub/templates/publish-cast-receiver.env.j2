# publish-cast-receiver environment — rendered by ansible (roles/pub), do not
# hand-edit; change roles/pub/defaults/main.yml and re-run pub.yml.
#
# CAST_RECEIVER_SRC is the cast-app/ directory of a local brasenia checkout
# (lentago/brasenia#13). It is a placeholder path until that checkout exists on
# pub; the publisher skips cleanly while it is absent.
CAST_RECEIVER_SRC={{ pub_cast_receiver_src }}
CAST_RECEIVER_DEST={{ pub_cast_receiver_dest }}
