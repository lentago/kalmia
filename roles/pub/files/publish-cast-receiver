#!/usr/bin/env bash
# Publish brasenia's Cast custom web receiver page to the pub.lan web share so
# it serves at http://pub.lan/cast/ — the URL registered in the Cast Developer
# Console (brasenia ADR-0006, kalmia#99).
#
# Source is brasenia's cast-app/ directory (the receiver is authored in
# brasenia, lentago/brasenia#13 — served here, never forked). Destination is
# the web root pub serves: /srv/www/cast, which is the NAS web share
# /volume1/lentago/web/cast/ mounted on pub. Config comes from the environment
# (set by the systemd unit / EnvironmentFile):
#
#   CAST_RECEIVER_SRC   path to a local brasenia checkout's cast-app/ directory
#   CAST_RECEIVER_DEST  publish target on the mounted web share
#
# Like publish-morning-brief, this is credential-free and skips cleanly rather
# than failing when its inputs are absent: no web share mounted, or no cast-app/
# source yet (brasenia#13 unmerged) → exit 0 with a note.
set -euo pipefail
SRC="${CAST_RECEIVER_SRC:?CAST_RECEIVER_SRC must be set}"
DEST="${CAST_RECEIVER_DEST:-/srv/www/cast}"

mountpoint -q /srv/www || { echo "web share not mounted; skipping" >&2; exit 0; }
if [ ! -d "$SRC" ]; then
    echo "cast-app source '$SRC' absent (brasenia#13 not checked out here?); skipping" >&2
    exit 0
fi

# Opportunistic freshness: if the source sits in a git checkout, ff-only pull
# so the served receiver tracks brasenia main on the daily timer. Best-effort —
# offline GitHub must not block republishing what's already checked out.
# The same checkout runs the brasenia viewport services (kalmia#140), so a pull
# that moves HEAD restarts them onto the new code. try-restart leaves stopped
# units stopped; a failed restart is logged, never fatal to the publish.
if git -C "$SRC" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    before=$(git -C "$SRC" rev-parse HEAD)
    if git -C "$SRC" pull --ff-only >/dev/null 2>&1; then
        after=$(git -C "$SRC" rev-parse HEAD)
        if [ "$before" != "$after" ]; then
            systemctl try-restart brasenia-compositor.service brasenia-focus.service brasenia-pipeline.service \
                && echo "brasenia moved ${before:0:7}..${after:0:7}; restarted viewport services" \
                || echo "brasenia moved but restarting viewport services failed" >&2
        fi
    else
        echo "git pull failed (offline?); publishing existing checkout" >&2
    fi
fi

mkdir -p "$DEST"
rsync -a --delete "$SRC"/ "$DEST"/
echo "published cast receiver from $SRC to $DEST (http://pub.lan/cast/)"
