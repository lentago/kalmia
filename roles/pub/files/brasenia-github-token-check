#!/usr/bin/env python3
# ============================================================================
# brasenia-github-token-check: test the GitHub token the brasenia prs and focus
# producers share (brasenia ADR-0021, kalmia#280), without ever printing it.
# Deployed by kalmia roles/pub. Run as root on pub after each seed or rotation:
#
#   brasenia-github-token-check [TOKEN_FILE]   (default /etc/brasenia/github-token)
#
# It makes two reads with the token:
#   1. GET /rate_limit: the token is accepted and gets the authenticated
#      limit, and GitHub's expiry header gives the date for the rotation record.
#   2. GET /repos/lentago/brasenia/commits/main/check-runs: whether a
#      fine-grained token may read check runs. GitHub's docs disagree on this,
#      and the focus producer needs it. ADR-0021 names the fallback if not.
#
# Exit 0: both pass. 1: the file is missing or empty, or the token is
# rejected. 2: the token works but check runs are refused. 3: anything else.
# ============================================================================
import json
import sys
import urllib.error
import urllib.request

API = "https://api.github.com"
CHECKS = "/repos/lentago/brasenia/commits/main/check-runs?per_page=1"


def get(token, path):
    req = urllib.request.Request(API + path, headers={
        "Authorization": f"Bearer {token}",
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28",
        "User-Agent": "brasenia-github-token-check",
    })
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            return resp.status, json.load(resp), resp.headers
    except urllib.error.HTTPError as err:
        return err.code, None, err.headers


def main():
    path = sys.argv[1] if len(sys.argv) > 1 else "/etc/brasenia/github-token"
    try:
        with open(path, encoding="utf-8") as fh:
            token = fh.read().strip()
    except FileNotFoundError:
        print(f"{path}: missing (the pub play creates it empty)")
        return 1
    if not token:
        print(f"{path}: empty, not seeded yet; the producers read anonymously")
        return 1

    status, body, headers = get(token, "/rate_limit")
    if status == 401:
        print("token rejected (401): expired, revoked or mistyped")
        return 1
    if status != 200 or not body:
        print(f"rate_limit: unexpected HTTP {status}")
        return 3
    core = body.get("resources", {}).get("core", {})
    print(f"token accepted: core limit {core.get('limit')}, remaining {core.get('remaining')}")
    expiry = headers.get("github-authentication-token-expiration")
    print(f"token expires: {expiry or 'no expiry header (not a fine-grained token?)'}")

    status, body, _ = get(token, CHECKS)
    if status == 200 and body is not None:
        print(f"check runs readable: total_count {body.get('total_count')}")
        return 0
    if status in (401, 403, 404):
        print(f"check runs refused (HTTP {status}): the focus producer needs ADR-0021's fallback")
        return 2
    print(f"check runs: unexpected HTTP {status}")
    return 3


if __name__ == "__main__":
    sys.exit(main())
