# pub.lan — Claude/LAN publish target. Serves the NAS drop folder with
# directory browsing. Drop files/folders into the lentago share under web/
# (laptop: /mnt/lentago/web, fleet/PVE host: /mnt/neptune-lentago/web) and
# they appear live. Add `reverse_proxy /app/* localhost:PORT` here later
# for dynamic content.
#
# Managed by kalmia (roles/pub/files/caddy/Caddyfile) — edit there, then
# re-run pub.yml on the container; the role validates and reloads Caddy.
:80 {
	root * /srv/www
	encode gzip

	# The change-pipeline document (kalmia#146). drosera's pipeline producer runs
	# on LXC 105 (grafana-stack, 192.168.139.20, a static reservation), where the
	# Loki credentials live, and serves the document on :8611; 105 mounts no web
	# share, so it reaches the viewport bus by proxy. Until the producer is up
	# this path answers 502, which the brasenia producers treat as "no rows".
	handle /viewport/pipeline.json {
		reverse_proxy 192.168.139.20:8611 {
			transport http {
				dial_timeout 2s
				response_header_timeout 5s
			}
		}
	}

	file_server {
		browse /etc/caddy/browse.html
	}
}
