#!/usr/bin/env bash
# ANSIBLE MANAGED — kalmia roles/dev_host. Mirrors this host's Claude state to the
# NAS (#286). One-way, with --delete: the mirror tracks the source.
# Retention: files a run deletes or overwrites are not kept by rsync, but the
# share's Samba recycle bin (/mnt/lentago/#recycle) catches deletes made over SMB.
# Not copied: ~/.claude.json and credentials (never leave this host).
set -euo pipefail

home="{{ target_home }}"
dest="{{ dev_host_claude_backup_dest }}"

# Fail closed: write only to the real CIFS mount, never to a bare local directory.
touch "{{ dev_host_nas_mountpoint }}/." 2>/dev/null || true
# (x-systemd.automount stacks autofs over cifs, so findmnt prints both.)
if ! findmnt -no FSTYPE -T "{{ dev_host_nas_mountpoint }}" | grep -qx cifs; then
  echo "claude-state-backup: {{ dev_host_nas_mountpoint }} is not a cifs mount" >&2
  exit 1
fi
mkdir -p "$dest"
chmod 0700 "$dest" 2>/dev/null || true

# CIFS has no unix owners or modes. -t keeps mtimes so unchanged files are
# skipped; rsync writes each file to a temp name and renames it into place.
opts=(-rt --no-perms --no-owner --no-group --delete --relative --modify-window=2)

cd "$home"
rsync "${opts[@]}" .claude/projects .claude/skills .claude/commands "$dest/" 2>&1 || {
  rc=$?; [ "$rc" -eq 24 ] || exit "$rc"; }   # 24: a file vanished mid-run, fine
singles=()
for f in .claude/CLAUDE.md .claude/settings.json CLAUDE.md repos/CLAUDE.md repos/lentago/CLAUDE.md; do
  [ -e "$f" ] && singles+=("$f")
done
# The clones' local permission grants.
while IFS= read -r f; do singles+=("${f#./}"); done < <(find repos -maxdepth 4 -path '*/.claude/settings.local.json' -type f)
# Delete-tracking for the single files comes from the directory-level run above
# only for dirs; mirror these without --delete so a removed clone keeps its copy.
rsync -rt --no-perms --no-owner --no-group --relative --modify-window=2 "${singles[@]}" "$dest/"
date -u +%FT%TZ > "$dest/.last-success"
